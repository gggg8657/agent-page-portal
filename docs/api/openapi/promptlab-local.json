  "/t/promptlab-local/api/run": {
   "post": {
    "tags": [
     "promptlab-local"
    ],
    "operationId": "promptlabRunStart",
    "summary": "A/B 실행 시작(작업)",
    "description": "원래·다듬은 프롬프트를 같은 조건으로 n번씩(두 쪽 동시에) — 결과·걸린 시간·토큰(usage). judge 면 마지막에 AI 판단(두 결과의 순서를 무작위로 바꿔 물음, 참고용). 무게 n(+판단 1)만큼 10분 횟수에서 셈. 202 로 작업을 돌려주고 api/run/{id} 로 확인.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PromptlabRunRequest"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "시작함",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PromptlabRunJob"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "409": {
      "description": "이미 AI 작업 중(code: busy, 사용자당 한 번에 하나)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
