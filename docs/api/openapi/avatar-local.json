  "/t/avatar-local/api/runs/{run_id}/{file}": {
   "get": {
    "tags": [
     "avatar-local"
    ],
    "operationId": "avatarRunFile",
    "summary": "영상·후보 그림 받기",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
       "description": "YYYY-MM-DD-xxxx"
      },
      "required": true
     },
     {
      "name": "file",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^(final\\.mp4|talk\\.mp4|move\\.mp4|cand_\\d\\.png)$"
      },
      "required": true
     }
    ],
    "responses": {
     "200": {
      "description": "Content-Disposition 없음, Range 미지원(전체 전송). 같은 이름으로 다시 만들어지므로 ?<시각> 을 붙여 캐시 회피(쿼리 무시됨)",
      "content": {
       "video/mp4": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "description": "삭제됐거나 없는 파일입니다",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/avatar-local/api/run": {
   "post": {
    "tags": [
     "avatar-local"
    ],
    "operationId": "avatarRun",
    "summary": "사진 + 대사 → 립싱크 영상 (SSE)",
    "description": "이벤트: {stage:'tts'|'lipsync',msg} · {log} · 끝 {done:{run_id,text,engine,device,ts}} → api/runs/<run_id>/final.mp4 · {error}. 사진은 본인/동의한 사람만(consent:true 필수). 본문 상한 약 28MB(사진 20MB base64 + 1MB) 넘으면 스트림 전에 413 {\"error\":\"요청이 너무 큽니다 (사진 20MB 이하)\"}.\n\n도중 오류도 HTTP 200 으로 오고 스트림 안 {\"error\": \"<예외이름>: 메시지\"} 이벤트로만 옴. 작업 id 폴링 API 없음 — 연결을 유지해야 함.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AvatarRunRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림 (data: <JSON>\\n\\n)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "SSE 스트림 (data: <JSON>\\n\\n)"
        },
