   "post": {
    "tags": [
     "avatar-local"
    ],
    "operationId": "avatarRunsDelete",
    "summary": "항목 휴지통으로",
    "description": "폴더째 <사용자 폴더>/.trash/<batch>/ 로 이동. 완전 삭제 API 없음.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AvatarDeleteRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AvatarDeleteResult"
        }
       }
      }
     },
     "400": {
      "description": "잘못된 항목입니다(형식 틀린 id 하나라도 있으면 아무것도 안 옮김)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "하나도 못 지움(모두 없음) — 같은 모양 본문",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AvatarDeleteResult"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/avatar-local/api/runs/{run_id}": {
   "delete": {
    "tags": [
     "avatar-local"
    ],
    "operationId": "avatarRunDelete",
    "summary": "항목 하나 휴지통으로(api/runs/delete 와 같음)",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
       "description": "YYYY-MM-DD-xxxx"
      },
      "required": true
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AvatarDeleteResult"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "description": "없음",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AvatarDeleteResult"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/avatar-local/api/runs/restore": {
   "post": {
    "tags": [
     "avatar-local"
    ],
    "operationId": "avatarRunsRestore",
    "summary": "휴지통 묶음 되살리기",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "batch": {
          "type": "string"
         }
        },
        "required": [
         "batch"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "같은 이름이 이미 있으면 건너뜀",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "restored": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         },
         "required": [
          "restored"
         ]
        }
       }
      }
     },
     "400": {
      "description": "잘못된 묶음입니다 / 휴지통에 없습니다",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/avatar-local/api/to_persona": {
   "post": {
    "tags": [
     "avatar-local"
    ],
    "operationId": "avatarToPersona",
    "summary": "(숨긴 기능) 고른 그림을 persona 캐릭터로",
    "description": "숨긴 도구(persona) 연동. 새 화면에서는 쓰지 않아도 됨.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "run_id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
          "description": "YYYY-MM-DD-xxxx"
         },
         "idx": {
          "type": "integer"
         },
         "name": {
          "type": "string"
         },
         "personality": {
          "type": "string"
         }
        },
        "required": [
         "run_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "persona 쪽 응답 JSON 그대로 — 코드 확인 필요",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "description": "코드 확인 필요"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "AvatarStatus": {
    "type": "object",
    "properties": {
     "sadtalker": {
      "type": "boolean"
     },
     "tts_server": {
      "type": "boolean",
      "description": "tts-local 응답함(없으면 영상 생성 불가)"
     },
     "device": {
      "type": "string",
      "enum": [
       "cpu",
       "cuda"
      ]
     },
     "s2v": {
      "type": "boolean",
      "description": "최고 품질 말하기(Wan2.2) 코드 있음"
     }
    },
    "required": [
     "sadtalker",
     "tts_server",
     "device",
     "s2v"
    ]
   },
   "AvatarStudio": {
    "type": "object",
    "properties": {
     "styles": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
       "type": "string"
      },
      "description": "키(real·virtual·3d·anime·webtoon·illust) → 한국어 이름"
     },
     "shots": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
       "type": "string"
      },
      "description": "키(face·half·full) → 한국어 이름"
     }
    },
    "required": [
     "styles",
     "shots"
    ]
   },
   "AvatarPhotoRun": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
      "description": "YYYY-MM-DD-xxxx"
     },
     "text": {
      "type": "string"
     },
     "engine": {
      "type": "string"
     },
     "device": {
      "type": "string"
     },
     "ts": {
      "type": "string"
     }
    },
    "required": [
     "run_id",
     "ts"
    ],
    "description": "사진 립싱크 meta — 영상 api/runs/<run_id>/final.mp4"
   },
   "AvatarCharacter": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
      "description": "YYYY-MM-DD-xxxx"
     },
     "kind": {
      "type": "string",
      "enum": [
       "character"
      ]
     },
     "desc": {
      "type": "string"
     },
     "style": {
      "type": "string"
     },
     "shot": {
      "type": "string"
     },
     "prompt": {
      "type": "string"
     },
     "negative": {
      "type": "string"
     },
     "n": {
      "type": "integer"
     },
     "ts": {
      "type": "string"
     },
     "candidates": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^cand_\\d\\.png$"
      }
     },
     "picked": {
      "type": "integer"
     },
     "talk": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string"
       },
       "engine": {
        "type": "string"
       },
       "model": {
        "type": "string"
       }
      },
      "description": "있으면 talk.mp4"
     },
     "move": {
      "type": "object",
      "properties": {
       "action": {
        "type": "string"
       },
       "prompt": {
        "type": "string"
       },
       "text": {
        "type": "string"
       },
       "quality": {
        "type": "string"
       },
       "model": {
        "type": "string"
       }
      },
      "description": "있으면 move.mp4"
     }
    },
    "required": [
     "run_id",
     "kind",
     "ts"
    ],
    "description": "가상 캐릭터 meta(meta.json 그대로)"
   },
   "AvatarRunItem": {
    "description": "api/runs 항목 — kind=character 면 가상 캐릭터, 없으면 사진 립싱크",
    "anyOf": [
     {
      "$ref": "#/components/schemas/AvatarCharacter"
     },
     {
      "$ref": "#/components/schemas/AvatarPhotoRun"
     }
    ]
   },
   "AvatarRunRequest": {
    "type": "object",
    "properties": {
     "photo_b64": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "얼굴 사진 base64(데이터 URL 접두어 제외), 20MB 이하"
     },
     "photo_name": {
      "type": "string",
      "pattern": "(?i)\\.(jpe?g|png)$",
      "description": ".jpg .jpeg .png 만"
     },
     "text": {
      "type": "string",
      "description": "대사"
     },
     "consent": {
      "type": "boolean",
      "description": "본인/동의한 사람 얼굴 확인. false 면 오류"
     }
    },
    "required": [
     "photo_b64",
     "photo_name",
     "text",
     "consent"
    ]
   },
   "AvatarImagineRequest": {
    "type": "object",
    "properties": {
     "desc": {
      "type": "string",
      "description": "캐릭터 묘사(성인 가상 인물)"
     },
     "style": {
      "type": "string",
      "enum": [
       "real",
       "virtual",
       "3d",
       "anime",
       "webtoon",
       "illust"
      ],
      "default": "real"
     },
     "shot": {
      "type": "string",
      "enum": [
       "face",
       "half",
       "full"
      ],
      "default": "half"
     },
     "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "default": 4
     }
    },
    "required": [
     "desc"
    ]
   },
   "AvatarSpeakRequest": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
      "description": "YYYY-MM-DD-xxxx"
     },
     "idx": {
      "type": "integer",
      "minimum": 0,
      "default": 0
     },
     "text": {
      "type": "string",
      "description": "대사"
     },
     "quality": {
      "type": "string",
      "enum": [
       "best",
       "fast"
      ],
      "default": "best",
      "description": "best=Wan2.2-S2V(5초당 약 25분, GPU 약 64GB) · fast=SadTalker(수십 초)"
     }
    },
    "required": [
     "run_id",
     "text"
    ]
   },
   "AvatarMoveRequest": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
      "description": "YYYY-MM-DD-xxxx"
     },
     "idx": {
      "type": "integer",
      "minimum": 0,
      "default": 0
     },
     "action": {
      "type": "string",
      "description": "어떻게 움직일지"
     },
     "text": {
      "type": "string",
      "description": "선택 — 있으면 음성을 입힘(입모양 동기화 아님)"
     },
     "quality": {
      "type": "string",
      "enum": [
       "best",
       "fast"
      ],
      "default": "best",
      "description": "best=720p급 40단계(약 30~35분) · fast=480p급 30단계(약 7분)"
     }
    },
    "required": [
     "run_id",
     "action"
    ]
   },
   "AvatarStageEvent": {
    "type": "object",
    "properties": {
     "stage": {
      "type": "string",
      "enum": [
       "tts",
       "lipsync",
       "s2v",
       "prompt",
       "draw",
       "worker",
       "load",
       "video"
      ]
     },
     "msg": {
      "type": "string"
     }
    },
    "required": [
     "stage"
    ]
   },
   "AvatarLogEvent": {
    "type": "object",
    "properties": {
     "log": {
      "type": "string",
      "description": "진행 줄(120자까지)"
     }
    },
    "required": [
     "log"
    ]
   },
   "AvatarImageEvent": {
    "type": "object",
    "properties": {
     "image": {
      "type": "integer",
      "description": "후보 번호(0부터) — api/runs/<run_id>/cand_<번호>.png"
     },
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
      "description": "YYYY-MM-DD-xxxx"
     }
    },
    "required": [
     "image",
     "run_id"
    ]
   },
   "AvatarStepEvent": {
    "type": "object",
    "properties": {
     "step": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "clip": {
      "type": "integer",
      "description": "speak best: 5초 조각 번호"
     }
    },
    "required": [
     "step",
     "total"
    ]
   },
   "AvatarErrorEvent": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string",
      "description": "'<예외이름>: 메시지'"
     }
    },
    "required": [
     "error"
    ]
   },
   "AvatarRunDone": {
    "type": "object",
    "properties": {
     "done": {
      "$ref": "#/components/schemas/AvatarPhotoRun"
     }
    },
    "required": [
     "done"
    ]
   },
   "AvatarImagineDone": {
    "type": "object",
    "properties": {
     "done": {
      "$ref": "#/components/schemas/AvatarCharacter"
     }
    },
    "required": [
     "done"
    ]
   },
   "AvatarVideoDone": {
    "type": "object",
    "properties": {
     "done": {
      "type": "object",
      "properties": {
       "run_id": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
        "description": "YYYY-MM-DD-xxxx"
       },
       "video": {
        "type": "string",
        "enum": [
         "talk.mp4",
         "move.mp4"
        ]
       },
       "engine": {
        "type": "string"
       },
       "model": {
        "type": "string"
       }
      },
      "required": [
       "run_id",
       "video"
      ]
     }
    },
    "required": [
     "done"
    ]
   },
   "AvatarDeleteRequest": {
    "type": "object",
    "properties": {
     "run_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
       "description": "YYYY-MM-DD-xxxx"
      },
      "maxItems": 200
     },
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$",
      "description": "YYYY-MM-DD-xxxx"
     }
    },
    "description": "run_ids(최대 200) 또는 run_id 하나"
   },
   "AvatarDeleteResult": {
    "type": "object",
    "properties": {
     "deleted": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "missing": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "batch": {
      "type": [
       "string",
       "null"
      ],
      "description": "되살리기용 묶음 id(아무것도 안 지웠으면 null)"
     }
    },
    "required": [
     "deleted",
     "missing",
     "batch"
    ]
   }
  },
  "responses": {
   "BadRequest": {
    "description": "입력이 잘못됨(본문이 JSON 객체가 아님, 필수 값 없음 등)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "PayloadTooLarge": {
    "description": "요청 본문이 너무 큼 — 상한은 operation description 참고",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "잠금·몰림·가입 제한(code: locked·ip_locked·busy·rate_limited) — Retry-After(초) 뒤 다시",
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer"
      }
     }
    },
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 }
}
