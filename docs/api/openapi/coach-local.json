     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "rids": {
          "type": "array",
          "items": {
           "type": "string"
          },
          "maxItems": 50
         }
        },
        "required": [
         "rids"
        ]
       }
      }
     }
    },
    "description": "포털은 브라우저 연결 끊김을 도구에 전하지 않으므로 fetch abort 뒤 이 API 로 서버 쪽 LLM 도 멈출 것. 같은 사용자 + 같은 rid 에만, 5분 뒤 지워짐.",
    "responses": {
