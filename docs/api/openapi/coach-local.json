        ]
       }
      }
     }
    },
    "description": "LLM, 보통 5~15초. 빈 글 → 400 {error:'검토할 글이 없습니다'}.",
    "x-llm": true,
    "x-long-running": true,
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CoachReviewResponse"
        }
