         "text"
        ]
       }
      }
     }
    },
    "description": "규칙으로 뽑은 값은 늘, llm:true 면 LLM 결과(llm)도. 취소되면 499.",
    "x-llm": true,
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
