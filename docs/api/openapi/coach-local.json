    }
   },
   "post": {
    "tags": [
     "coach-local"
    ],
    "operationId": "coachDocSave",
    "summary": "문서 저장(자동 저장·판 남기기)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "기존 id 또는 빈 값(새로)"
         },
         "title": {
          "type": "string",
          "description": "비면 첫 줄 40자"
         },
         "text": {
          "type": "string"
         },
         "persona": {
          "type": "string",
          "description": "페르소나 id"
         },
         "purpose": {
          "type": "string"
         },
         "profile_user": {
          "$ref": "#/components/schemas/CoachProfileUser"
         },
         "snapshot": {
          "type": "boolean",
          "default": false,
          "description": "true 면 내용이 바뀌었을 때 판 하나 더(최대 30개). 마지막 판이 10분 넘어도 남김"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$"
          },
          "title": {
           "type": "string"
          },
          "updated": {
           "type": "string"
          },
          "versions": {
           "type": "integer",
           "description": "판 수"
          }
         },
         "required": [
          "id",
          "title",
          "updated",
          "versions"
         ]
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
