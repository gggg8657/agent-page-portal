      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "text": {
         "type": "string",
         "maxLength": 3000
        }
       },
       "required": [
        "id",
        "text"
       ]
      },
      "maxItems": 20,
      "description": "(나) 단순 방식 — 문단 목록. 규칙 검사 없음"
     },
     "pass": {
      "type": "string",
      "enum": [
       "spell",
       "style",
       "rules"
