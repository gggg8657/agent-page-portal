  "/t/coach-local/api/import_ok": {
   "get": {
    "tags": [
     "coach-local"
    ],
    "operationId": "coachImportOk",
    "summary": "HWP·HWPX·PDF 가져오기 가능 여부",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "kordoc": {
           "type": "boolean",
           "description": "true 면 .hwp .hwpx .pdf .hml 도 받음"
          }
         },
         "required": [
          "kordoc"
         ]
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/coach-local/api/import": {
   "post": {
    "tags": [
     "coach-local"
    ],
    "operationId": "coachImport",
    "summary": "파일 → 글(텍스트)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "file_name": {
          "type": "string",
          "description": "확장자로 형식 판단"
         },
         "file_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "파일 내용 base64. 늘 되는 형식 .txt .md(UTF-8·CP949) .docx, kordoc 켜져 있으면 .hwp .hwpx .pdf .hml"
         }
        },
        "required": [
         "file_name",
         "file_b64"
        ]
       }
      }
     }
    },
    "description": "JSON 안 base64 업로드. kordoc 변환은 최대 180초. 지원 안 하는 형식 → 400, 변환 실패 → 500. 업로드 상한은 문서·코드에 따로 없음(포털 기본).",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "text": {
           "type": "string"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "text",
          "name"
         ]
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/coach-local/api/export": {
   "post": {
    "tags": [
     "coach-local"
    ],
    "operationId": "coachExport",
    "summary": "글 → .docx 내려받기",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "title": {
          "type": "string",
          "description": "비면 '글'"
         },
         "text": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": ".docx 바이너리(줄 = 문단, 맑은 고딕). POST 라 fetch 후 blob() 으로 저장",
      "content": {
       "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      },
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename*=UTF-8''<제목>.docx"
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
