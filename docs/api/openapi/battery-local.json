    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/battery-local/api/ask": {
   "post": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryAsk",
    "summary": "자연어 질문 → 설정(→ 바로 제출) (SSE)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "question": {
          "type": "string",
          "description": "앞 2000자만 씀"
         },
         "model": {
          "type": "string"
         },
         "run": {
          "type": "boolean",
          "default": true,
          "description": "false 면 설정만 돌려줌"
         }
        },
        "required": [
         "question"
        ]
       }
      }
     }
    },
