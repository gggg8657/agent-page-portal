     }
    }
   }
  },
  "/t/battery-local/api/jobs": {
   "get": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryJobs",
    "summary": "내 작업 목록(최근 순, 최대 300) + 대기열",
    "description": "화면은 4초마다 새로 고침. 서버 주인(owner)은 예전 기록도 봄.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "jobs": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/BatteryJobStatus"
           }
          },
          "queue": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "description": "대기 중인 내 작업 id"
          }
         },
         "required": [
          "jobs",
          "queue"
         ]
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   },
   "post": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batterySubmit",
    "summary": "계산 작업 제출(큐)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "oneOf": [
         {
          "type": "object",
          "properties": {
           "job": {
            "$ref": "#/components/schemas/BatteryJobConfig"
           }
          },
          "required": [
           "job"
          ]
         },
         {
          "$ref": "#/components/schemas/BatteryJobConfig"
         }
        ],
        "description": "{job: {...}} 또는 설정 객체 그대로"
       }
      }
     }
    },
    "description": "CPU 별도 프로세스(GPU 아님). 동시 meta.max_jobs(기본 2), 나머지는 모든 사용자 공용 대기열. 수 초~수십 분, 작업당 최대 7200초. 이후 GET api/jobs/{id} 폴링.",
    "x-long-running": true,
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
           "description": "YYYYMMDD-HHMMSS-xxxx. 형식이 다르면 404"
          }
         },
         "required": [
          "id"
         ]
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/battery-local/api/jobs/{id}": {
   "get": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryJob",
    "summary": "작업 상태·설정·결과·해설(폴링)",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
       "description": "YYYYMMDD-HHMMSS-xxxx. 형식이 다르면 404"
      }
     }
    ],
    "description": "state 가 queued/running 인 동안 폴링(화면 1.5초). result·partial·explain 은 있을 때만. 남의 작업·없는 id → 404 {error:'없음'}.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BatteryJobDetail"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/battery-local/api/jobs/{id}/file/{name}": {
   "get": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryFile",
    "summary": "결과 파일 다운로드(CSV·PNG·JSON)",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
       "description": "YYYYMMDD-HHMMSS-xxxx. 형식이 다르면 404"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[^.].*\\.(csv|png|json)$"
      },
      "description": "plot.png·summary.csv·curves.csv·cycles.csv·result.json — 목록은 result.files(+result.json)"
     }
    ],
    "responses": {
     "200": {
      "description": "파일. CSV 는 UTF-8 BOM 포함",
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename=\"battery-{id}-{name}\""
       }
      },
      "content": {
       "text/csv": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/battery-local/api/validate": {
   "post": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryValidate",
    "summary": "설정 검사·기본값 채우기(실행 안 함)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "oneOf": [
         {
          "type": "object",
          "properties": {
           "job": {
            "$ref": "#/components/schemas/BatteryJobConfig"
           }
          },
          "required": [
           "job"
          ]
         },
         {
          "$ref": "#/components/schemas/BatteryJobConfig"
         }
        ],
        "description": "{job: {...}} 또는 설정 객체 그대로"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "job": {
           "$ref": "#/components/schemas/BatteryJobConfig"
          },
          "steps": {
           "type": [
            "array",
            "null"
           ],
           "items": {
            "type": "array",
            "items": {
             "type": "string"
            }
           },
           "description": "life 일 때 시나리오별 한 사이클 실험 문자열, 아니면 null"
          }
         },
         "required": [
          "job",
          "steps"
         ]
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/battery-local/api/jobs/{id}/cancel": {
   "post": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryCancel",
    "summary": "대기·실행 중 작업 취소",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
       "description": "YYYYMMDD-HHMMSS-xxxx. 형식이 다르면 404"
      }
     }
    ],
    "requestBody": {
     "required": false,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {}
       }
      }
     }
    },
    "description": "이미 끝난 작업이면 409 {error:'이미 끝난 작업은 취소할 수 없습니다'}.",
    "x-permission": "creator",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "$ref": "#/components/responses/Conflict"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
