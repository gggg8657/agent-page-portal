 "paths": {
  "/t/battery-local/api/health": {
   "get": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryHealth",
    "summary": "서버·PyBaMM 상태",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "python": {
           "type": "boolean",
           "description": "PyBaMM 파이썬을 찾았는지"
          },
          "pybamm": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "ok",
          "python",
          "pybamm"
         ]
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/battery-local/api/meta": {
   "get": {
    "tags": [
     "battery-local"
    ],
    "operationId": "batteryMeta",
    "summary": "파라미터 세트·모델·한도 정보",
    "description": "첫 호출만 수 초~수십 초(세트 정보 계산 후 캐시). 모든 사용자 공용.",
    "x-shared-data": true,
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/BatteryMeta"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
