       }
      }
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "WriterPatternInput": {
    "type": "object",
    "properties": {
     "key": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "enum": [
       "text",
       "textarea",
       "select",
       "number"
      ]
     },
     "required": {
      "type": "boolean"
     },
     "placeholder": {
      "type": [
       "string",
       "number"
      ],
      "description": "입력 칸 안내 문구(숫자 칸이면 숫자 예시)"
     },
     "options": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "type=select 일 때"
     }
    },
    "required": [
     "key",
     "label",
     "type"
    ]
   },
   "WriterPattern": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "패턴 id(예 apology)"
     },
     "title": {
      "type": "string"
     },
     "category": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "outputs": {
      "type": "integer",
      "minimum": 1,
      "description": "만들 안(variant) 수"
     },
     "inputs": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/WriterPatternInput"
      }
     }
    },
    "description": "지시문 본문(prompt)은 빠짐. 서버 patterns/*.md 에서 기동 시 읽음",
    "required": [
     "name",
     "title",
     "inputs"
    ]
   },
   "WriterRunSummary": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{6}-[0-9a-f]{2}$"
     },
     "title": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "ts": {
      "type": "string"
     },
     "head": {
      "type": "string",
      "description": "첫 안 앞 40자"
     }
    },
    "required": [
     "run_id",
     "title",
     "model",
     "ts",
     "head"
    ]
   },
   "WriterResult": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-\\d{6}-[0-9a-f]{2}$"
     },
     "pattern": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "values": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "{입력 key: 값}"
     },
     "tweak": {
      "type": [
       "string",
       "null"
      ]
     },
     "variants": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "안 배열(최대 outputs 개)"
     },
     "raw": {
      "type": "string",
      "description": "모델 출력 전체 — 여러 안이면 ===== 줄로 구분"
     },
     "ts": {
      "type": "string"
     }
    },
    "required": [
     "run_id",
     "pattern",
     "title",
     "model",
     "variants",
     "raw",
     "ts"
    ]
   },
   "WriterStageEvent": {
    "type": "object",
    "properties": {
     "stage": {
      "type": "string",
      "enum": [
       "llm"
      ]
     },
     "msg": {
      "type": "string"
     },
     "reset": {
      "type": "boolean",
      "description": "true 면 받은 토큰을 지움(빈 출력 재시도 포함)"
     }
    },
    "required": [
     "stage",
     "msg"
    ]
   },
   "WriterTokenEvent": {
    "type": "object",
    "properties": {
     "token": {
      "type": "string"
     }
    },
    "required": [
     "token"
    ]
   },
   "WriterDoneEvent": {
    "type": "object",
    "properties": {
     "done": {
      "$ref": "#/components/schemas/WriterResult"
     }
    },
    "required": [
     "done"
    ]
   },
   "WriterErrorEvent": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string",
      "description": "예: ValueError: 필수 입력: 사과 대상"
     }
    },
    "required": [
     "error"
    ]
   },
   "WriterAvailable": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     }
    },
    "required": [
     "ok"
    ]
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "NotFound": {
    "description": "없는 경로·도구·항목",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "ServerError": {
    "description": "서버 내부 오류",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "잠금·몰림·가입 제한(code: locked·ip_locked·busy·rate_limited) — Retry-After(초) 뒤 다시",
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer"
      }
     }
    },
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 }
}
