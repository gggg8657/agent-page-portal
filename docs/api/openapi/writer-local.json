       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "output": {
           "type": "string"
          }
         },
         "required": [
          "output"
         ]
        }
       }
      }
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/t/writer-local/api/polish_ok": {
   "get": {
    "tags": [
     "writer-local"
