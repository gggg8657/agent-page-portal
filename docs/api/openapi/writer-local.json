     }
    }
   }
  },
  "/t/writer-local/api/generate": {
   "post": {
    "tags": [
     "writer-local"
    ],
    "operationId": "writerGenerate",
    "summary": "패턴으로 글 생성 (SSE)",
    "description": "LLM 1콜, 수 초~수십 초. 스트림: {stage:'llm',msg,reset:true} → {token}… → {done:{결과}}. 토큰은 여러 안이 ===== 로 이어진 원문 — 안별 결과는 done.variants. 빈 출력이면 1회 자동 재시도(토큰이 다시 흐름). 도중 오류도 HTTP 200 으로 오고 스트림 안 {error} 이벤트로만 옴(패턴 없음·필수 입력 빠짐 포함).",
    "x-llm": true,
    "x-long-running": true,
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "pattern": {
          "type": "string",
          "description": "패턴 name"
         },
         "values": {
          "type": "object",
          "additionalProperties": {
           "type": "string"
          },
          "description": "{입력 key: 값}. required 칸이 비면 오류"
         },
         "model": {
          "type": "string",
          "description": "비우면 서버 기본"
         },
         "tweak": {
          "type": "string",
          "enum": [
           "shorter",
           "formal",
           "casual"
          ],
          "description": "prev 와 함께일 때만 적용"
         },
         "prev": {
          "type": "string",
          "description": "고칠 직전 결과 글(안 하나)"
         }
        },
        "required": [
         "pattern"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림 (data: <JSON>\\n\\n)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "SSE 스트림 (data: <JSON>\\n\\n)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/WriterStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/WriterTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/WriterDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/WriterErrorEvent"
          }
         }
        ]
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
