        "schema": {
         "$ref": "#/components/schemas/CodingtestJudgeResult"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "description": "이미 같은 일을 하는 중(code: busy, 사용자당 한 번에 하나)",
