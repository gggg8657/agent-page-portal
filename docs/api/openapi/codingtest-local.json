     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^c\\d{3}$"
      }
     }
    ]
   }
  },
  "/t/codingtest-local/api/run": {
   "post": {
    "tags": [
     "codingtest-local"
    ],
    "operationId": "codingtestRun",
    "summary": "예제 실행(또는 직접 입력 실행)",
    "description": "격리 컨테이너에서 예제 전부를 돌려 출력·기대 출력을 보여 줌(기록에는 초안 코드만 저장, 제출 수에 안 셈). input 이 있으면 그 입력 하나만(비교 없음, verdict DONE). 사용자당 동시 1(409)·채점(run+submit) 10분 40번(429).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CodingtestCodeRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
