       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-long-running": true
   }
  },
