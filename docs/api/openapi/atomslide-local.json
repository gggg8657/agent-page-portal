     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "export_as": {
          "type": "string",
          "enum": [
           "pptx",
           "pdf"
          ]
         }
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "x-long-running": true
   }
  },
  "/t/atomslide-local/app_data/exports/users/{uid}/{name}": {
   "get": {
    "tags": [
     "atomslide-local"
    ],
    "operationId": "atomslideDownload",
    "summary": "내보낸 파일 내려받기",
    "description": "generate·export 가 준 path 앞에 /t/atomslide-local. 자기 파일만(남의 것 404).",
    "responses": {
     "200": {
      "description": "파일",
      "content": {
       "application/vnd.openxmlformats-officedocument.presentationml.presentation": {},
       "application/pdf": {}
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "parameters": [
     {
      "name": "uid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "name",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ]
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "responses": {
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   }
  },
  "schemas": {
   "AtomslideHealth": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "tool": {
      "type": "string"
     },
     "version": {
      "type": [
       "string",
       "null"
      ]
     },
     "auth": {
      "type": "string"
     },
     "app": {
      "type": "object",
      "properties": {
       "ok": {
        "type": "boolean"
       },
       "fastapi": {
        "type": "boolean"
       },
       "nextjs": {
        "type": "boolean"
       }
      }
     },
     "llm": {
      "type": "object",
      "additionalProperties": true
     }
    }
   },
   "AtomslideGenerate": {
    "type": "object",
    "required": [
     "content"
    ],
    "additionalProperties": true,
    "description": "코드 확인 필요 — 전체 필드는 Presenton GeneratePresentationRequest",
    "properties": {
     "content": {
      "type": "string",
      "description": "요청 문장(주제·대상·목적)"
     },
     "n_slides": {
      "type": "integer",
      "minimum": 1
     },
     "language": {
      "type": "string",
      "example": "Korean"
     },
     "template": {
      "type": "string",
      "example": "research_kr"
     },
     "instructions": {
      "type": "string"
     },
     "files": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "export_as": {
      "type": "string",
      "enum": [
       "pptx",
       "pdf"
      ]
     }
    }
   },
   "AtomslidePath": {
    "type": "object",
    "properties": {
     "presentation_id": {
      "type": "string",
      "format": "uuid"
     },
     "path": {
      "type": "string",
      "description": "/app_data/exports/users/<id>/… — 앞에 /t/atomslide-local 를 붙여 내려받음"
     },
     "edit_path": {
      "type": "string"
     }
    }
   },
   "AtomslidePresentation": {
    "type": "object",
    "additionalProperties": true,
    "description": "코드 확인 필요 — Presenton PresentationWithSlides"
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "probe_blocked",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   }
  }
 }
}
