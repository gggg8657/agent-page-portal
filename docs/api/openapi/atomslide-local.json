  "x-description": "주제·문서로 발표 슬라이드 초안을 만들고 PPTX·PDF로 내보내기",
  "x-kind": "agent",
  "x-kind-note": "목차·슬라이드 글은 LLM, 내보내기는 헤드리스 크로미엄",
  "x-category": "업무지원",
  "x-category-note": "발표자료 작성",
  "x-entry": "/t/atomslide-local/",
  "x-health-path": "/t/atomslide-local/healthz",
  "x-long-running": true,
  "x-long-running-note": "generate 는 동기(3장 약 1.5분) — 화면은 단계별 SSE",
  "x-docs-input": "json",
  "x-docs-input-note": "글 요청 + 첨부는 업로드 뒤 경로",
  "x-external-network": false,
  "x-external-network-note": "앱 컨테이너는 인터넷 없는 내부 망, LLM 은 호스트 vLLM 중계만",
  "x-response-style": "json"
 },
 "servers": [
