   "cookieAuth": []
  }
 ],
 "tags": [
  {
   "name": "atomslide-local",
   "description": "AtomSlide 발표자료(Presenton 기반) — 관문이 넘기는 주요 API. 문서: docs/api/atomslide-local.md"
  }
 ],
 "paths": {
  "/t/atomslide-local/healthz": {
   "get": {
    "tags": [
     "atomslide-local"
    ],
    "operationId": "atomslideHealth",
    "summary": "살아 있는지(관문 + 앱 + LLM 중계)",
    "description": "서명·로그인 없이도 됨. 앱이 준비되지 않았으면 503.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AtomslideHealth"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "security": []
   }
  },
  "/t/atomslide-local/api/v1/ppt/presentation/all": {
   "get": {
    "tags": [
     "atomslide-local"
    ],
    "operationId": "atomslideList",
    "summary": "내 발표자료 목록",
    "description": "포털 사용자별(자동으로 만든 Presenton 계정) — 남의 것은 안 보임.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/AtomslidePresentation"
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/atomslide-local/api/v1/ppt/presentation/{id}": {
   "get": {
    "tags": [
     "atomslide-local"
    ],
    "operationId": "atomslideGet",
    "summary": "발표자료 하나",
    "description": "남의 것은 404.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AtomslidePresentation"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ]
   },
   "delete": {
    "tags": [
     "atomslide-local"
    ],
    "operationId": "atomslideDelete",
    "summary": "발표자료 지우기",
    "description": "남의 것은 404.",
    "responses": {
     "200": {
      "description": "지움"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ]
   }
  },
  "/t/atomslide-local/api/v1/ppt/presentation/generate": {
   "post": {
    "tags": [
     "atomslide-local"
    ],
    "operationId": "atomslideGenerate",
    "summary": "한 번에 만들고 내보내기(동기)",
    "description": "요청 → 목차 → 슬라이드 → PPTX/PDF. 3장 약 1.5분(LLM). 화면은 단계별 SSE API 를 씀.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AtomslidePath"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AtomslideGenerate"
       }
      }
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
  "/t/atomslide-local/api/v1/ppt/presentation/{id}/export": {
   "post": {
    "tags": [
