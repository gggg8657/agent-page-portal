     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   },
   "post": {
    "tags": [
     "strategy-local"
    ],
    "operationId": "strategySave",
    "summary": "부분 저장(입력·SWOT·전략·로직모델)",
    "description": "rev 가 지금 doc.revs[part] 와 다르면 409 conflict + 최신 doc(다른 탭·AI 초안이 먼저 바꿈). 서버가 길이·개수(칸 15·전략 8·단계 12)·id·src 를 검사하고, SWOT 에서 지운 항목을 가리키던 전략 연결은 걷음. 전략 연결은 짝 칸(SO 는 S·O …)의 항목만 남음. AI 가 그 부분을 만드는 중이면 409 busy.",
    "parameters": [
     {
      "name": "aid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{10}$"
      },
      "description": "분석 id"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/StrategySave"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StrategyDoc"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "description": "판 충돌(code: conflict, 최신 doc 포함) 또는 AI 초안 중(code: busy)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StrategyConflict"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
