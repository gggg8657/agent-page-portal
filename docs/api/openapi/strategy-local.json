  "/t/strategy-local/api/analyses/{aid}/generate": {
   "post": {
    "tags": [
     "strategy-local"
    ],
    "operationId": "strategyGenerate",
    "summary": "AI 초안 시작(작업)",
    "description": "swot: 입력(설명·메모·첨부 16,000자) → 칸마다 2~5개 + 근거 인용, 서버가 인용을 입력에서 다시 찾음(정규화 뒤 비슷함 0.85 이상 + 인용 속 숫자가 입력에 있어야, 아니면 검토 제안). 입력이 모자라면 SWOT 대신 insufficient(질문·예시). tows: 지금 SWOT → SO·WO·ST·WT 1~3개 + 우선 전략 3개(항목 번호가 짝에 맞는지 확인). logic: 여섯 단계 + 가정·외부 요인, 목표 수치가 입력에 없으면 '설정 필요'. all = 세 가지 차례로(SWOT 이 모자라면 전략은 건너뜀). 덮기 전 내용은 undo 로 되돌릴 수 있음. 202 로 작업을 돌려주고 …/job 을 2초마다 확인. 사용자당 동시 1·1시간 30번, 도구 전체 동시 2.",
    "parameters": [
     {
      "name": "aid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{10}$"
      },
      "description": "분석 id"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/StrategyGenerate"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "시작함",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/StrategyJobWrap"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "description": "이미 만드는 중이거나 자리가 없음(code: busy)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "503": {
      "description": "LLM 이 연결되지 않음(code: unavailable)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
