 "paths": {
  "/t/padong-local/api/info": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongInfo",
    "summary": "동작·장면·표정 목록, 모델 이름",
    "description": "actions/plays 는 기본 목록만(플러그인 것은 없음 — api/plugins). 포털 펫은 이 주소가 응답하는지로 도구가 켜져 있는지 판단. 응답은 Cache-Control: no-store.",
    "responses": {
     "200": {
      "description": "정보",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PadongInfo"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/padong-local/api/versions": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongVersions",
    "summary": "볼 수 있는 예전 버전 목록",
    "description": "각 값 v 에 대해 GET /t/padong-local/v<v> 로 그 버전 화면(HTML)이 열림.",
    "responses": {
     "200": {
      "description": "버전",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "versions"
         ],
         "properties": {
          "versions": {
           "type": "array",
           "items": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$"
           }
          }
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/padong-local/api/plugins": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongPlugins",
    "summary": "플러그인 JS 파일 목록",
    "description": "static/ 안의 outfit_*.js·behav_*.js 이름. 화면은 static/<이름> 을 ES 모듈로 불러옴. 각 파일 맨 앞 export const META 의 plays·acts·outfits 를 서버가 읽어 허용 목록에 더함.",
    "responses": {
     "200": {
      "description": "파일",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "files"
         ],
         "properties": {
          "files": {
           "type": "array",
           "items": {
            "type": "string",
            "pattern": "^(outfit|behav)_[a-z0-9_]+\\.js$"
           }
          }
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/padong-local/api/weather": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongWeather",
    "summary": "현재 날씨(고정 좌표)",
    "x-shared-data": true,
    "x-external-network": true,
    "description": "공개 날씨 API(Open-Meteo)에 고정 좌표만 보내 받음, 20분 캐시(모든 사용자 공유). 실패도 200 {\"ok\": false, \"error\"} (캐시 시간 동안 유지).",
    "responses": {
     "200": {
      "description": "날씨",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PadongWeather"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/padong-local/api/gpu": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongGpu",
