       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/padong-local/api/poll": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongPoll",
    "summary": "바깥에서 넣은 명령 가져오기(사용자별 큐)",
    "parameters": [
     {
      "name": "since",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0
      },
      "description": "마지막으로 받은 명령 id"
     }
    ],
    "description": "큐는 사용자(X-Agent-User)별 메모리, 최근 50개만, 서버 재시작 시 비워짐. 화면은 처음에 since=0 으로 last 만 받아 두고(예전 명령은 실행하지 않음) 1.2초마다 폴링.",
    "responses": {
     "200": {
      "description": "명령",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PadongPoll"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/padong-local/api/command": {
   "post": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongCommand",
    "summary": "자연어 → steps",
    "x-llm": true,
    "description": "스트리밍 없음, 한 번에(LLM 제한시간 120초, 보통 5~15초). LLM 이 실패하거나 빈 steps 를 주면 지금 화면은 브라우저 쪽 낱말 규칙으로 대신 동작을 만듦(서버에는 없음). 본문이 JSON 객체가 아니면 400 {\"error\": \"잘못된 요청 (…)\"}, 필드 형식이 틀리면 400 {\"error\": \"잘못된 요청: <사유>\"}, LLM·TTS 실패 502 {\"error\": \"<예외이름>: <메시지>\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PadongCommandRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "steps(0~8개)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PadongSteps"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/t/padong-local/api/pet": {
   "post": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongPet",
    "summary": "포털 펫의 대답·혼잣말 → steps (+도구 추천)",
    "x-llm": true,
    "description": "포털·모든 도구 화면 아래 펫(static/pet.js)이 쓰는 대화. 포털 도구 목록은 포털 /api/tools 를 60초 캐시(숨긴 도구 제외). 대사에 dir 이 섞이면 서버가 도구 이름으로 바꿈. LLM 이 꺼져 있고 chat 이면 낱말 매칭으로 도구를 찾아 offline: true, 찾은 게 없으면 502. 펫 상태는 서버에 저장하지 않음(클라이언트가 매번 보냄). 본문이 JSON 객체가 아니면 400 {\"error\": \"잘못된 요청 (…)\"}, 필드 형식이 틀리면 400 {\"error\": \"잘못된 요청: <사유>\"}, LLM·TTS 실패 502 {\"error\": \"<예외이름>: <메시지>\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PadongPetRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "대답",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PadongPetResponse"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/t/padong-local/api/push": {
   "post": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongPush",
    "summary": "명령을 큐에 넣기(열린 화면이 실행)",
    "description": "넣은 사람(X-Agent-User)의 화면만 움직임. text 면 LLM 으로 steps 생성. 화면이 안 열려 있어도 큐에 쌓이지만(최근 50개) 화면은 열릴 때 그 전 명령을 건너뜀. 본문이 JSON 객체가 아니면 400 {\"error\": \"잘못된 요청 (…)\"}, 필드 형식이 틀리면 400 {\"error\": \"잘못된 요청: <사유>\"}, LLM·TTS 실패 502 {\"error\": \"<예외이름>: <메시지>\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PadongPushRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "큐 id",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PadongPushResponse"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/t/padong-local/api/tts": {
   "post": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongTts",
    "summary": "대사 → WAV 음성(tts-local 중계)",
    "description": "포털의 TTS 도구(OpenAI 호환 /v1/audio/speech)로 넘기기만 함. Content-Type 은 TTS 도구가 준 값(보통 audio/wav), 파일 이름 헤더(Content-Disposition) 없음. TTS 도구가 꺼져 있으면 502 {\"error\": \"URLError: ...\"}. 본문이 JSON 객체가 아니면 400 {\"error\": \"잘못된 요청 (…)\"}, 필드 형식이 틀리면 400 {\"error\": \"잘못된 요청: <사유>\"}, LLM·TTS 실패 502 {\"error\": \"<예외이름>: <메시지>\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PadongTtsRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "WAV 바이트",
      "content": {
       "audio/wav": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/t/padong-local/ref/{file}": {
   "get": {
    "tags": [
     "padong-local"
    ],
    "operationId": "padongRef",
    "summary": "원본 자료 그림(관리자만)",
    "x-permission": "admin",
    "parameters": [
     {
      "name": "file",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^(cha_padong_(intro|full01|turn|pose01|full02|pose02|pic01|pic02|pic03|credit)\\.jpg|cha_padong_turn\\.gif|wall_(0[1-9]|1[0-9]|20)\\.jpg)$"
      },
      "description": "허용 목록(REF_FILES) 31개 이름만, 그 밖은 404"
     }
    ],
    "description": "화면 '원본 자료' 창이 부르는 비공개 원본. 관리자(owner)만 — 다른 사용자는 403 {\"error\": \"원본 자료는 관리자만 볼 수 있습니다\"}. api/info 의 ref 로 볼 수 있는지 알 수 있음. Cache-Control: max-age=86400.",
    "responses": {
     "200": {
      "description": "그림",
      "content": {
       "image/jpeg": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/gif": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "PadongStep": {
    "type": "object",
    "description": "동작 한 단계. 서버가 정리(clean_steps): 목록에 없는 do/play/expr 는 버리고, do·say·play 가 하나도 없는 단계는 빼고, 최대 8단계. play 는 steps 전체에서 하나만(두 번째부터 버려짐)",
    "properties": {
     "do": {
      "type": "string",
      "description": "동작 이름 — api/info actions 키 + 플러그인 동작"
     },
     "play": {
      "type": "string",
      "description": "여러 단계 장면(do 대신) — api/info plays 키 + 플러그인 장면"
     },
     "expr": {
      "type": "string",
      "description": "표정 — api/info exprs 중 하나"
     },
     "say": {
      "type": "string",
      "maxLength": 200,
      "description": "말할 대사(200자로 자름)"
     },
     "times": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 1,
      "description": "반복 1~5(범위 밖이면 잘림)"
     }
    }
   },
   "PadongSteps": {
    "type": "object",
    "required": [
     "steps"
    ],
    "properties": {
     "steps": {
      "type": "array",
      "maxItems": 8,
      "items": {
       "$ref": "#/components/schemas/PadongStep"
      }
     }
    }
   },
   "PadongHistoryItem": {
    "type": "object",
    "required": [
     "role",
     "content"
    ],
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "user",
       "assistant"
      ]
     },
     "content": {
      "type": "string",
      "description": "각 800자까지 씀. 화면은 assistant 기록으로 JSON.stringify({steps}) 를 넣음"
     }
    }
   },
   "PadongInfo": {
    "type": "object",
    "required": [
     "actions",
     "plays",
     "exprs",
     "model",
     "ref"
    ],
    "properties": {
     "actions": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "기본 동작 이름 → 설명(플러그인 동작은 빠짐)"
     },
     "plays": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "기본 장면 이름 → 설명"
     },
     "exprs": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "표정 이름"
     },
     "model": {
      "type": "string",
      "description": "LLM 모델 이름"
     },
     "ref": {
      "type": "boolean",
      "description": "원본 자료(ref/)를 볼 수 있는지 — 관리자(owner)만 true"
     }
    }
   },
   "PadongWeather": {
    "type": "object",
    "required": [
     "ok"
    ],
    "description": "실패도 200 {ok:false, error}",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "temp": {
      "type": "number",
      "description": "기온 ℃"
     },
     "rain": {
      "type": "boolean"
     },
     "snow": {
      "type": "boolean"
     },
     "code": {
      "type": "integer",
      "description": "WMO 날씨 코드"
     },
     "error": {
      "type": "string"
     }
    }
   },
   "PadongGpuItem": {
    "type": "object",
    "required": [
     "i",
     "util",
     "temp",
     "mem",
     "memTotal"
    ],
    "properties": {
     "i": {
      "type": "integer"
     },
     "util": {
      "type": "number",
      "description": "%"
     },
     "temp": {
      "type": "number",
      "description": "℃"
     },
     "mem": {
      "type": "number",
      "description": "MiB"
     },
     "memTotal": {
      "type": "number",
      "description": "MiB"
     }
    }
   },
   "PadongGpu": {
    "type": "object",
    "required": [
     "ok"
    ],
    "description": "실패도 200 {ok:false, error}",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "gpus": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongGpuItem"
      }
     },
     "hot": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongGpuItem"
      },
      "description": "사용률 ≥90% 또는 온도 ≥80℃ 인 GPU"
     },
     "idle": {
      "type": "boolean",
      "description": "모두 사용률 <5%"
     },
     "error": {
      "type": "string"
     }
    }
   },
   "PadongQueueItem": {
    "type": "object",
    "required": [
     "id",
     "steps"
    ],
    "properties": {
     "id": {
      "type": "integer"
     },
     "steps": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongStep"
      }
     },
     "text": {
      "type": "string",
      "description": "원래 문장(text 로 넣었을 때만)"
     }
    }
   },
   "PadongPoll": {
    "type": "object",
    "required": [
     "items",
     "last"
    ],
    "properties": {
     "items": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongQueueItem"
      },
      "description": "id > since 인 명령"
     },
     "last": {
      "type": "integer",
      "description": "큐의 마지막 id(비면 since 그대로)"
     }
    }
   },
   "PadongCommandRequest": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string",
      "description": "시킬 말. 비면 400 {\"error\": \"빈 명령\"}"
     },
     "history": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongHistoryItem"
      },
      "description": "이전 대화, 최근 8개만 씀"
     }
    }
   },
   "PadongPetContext": {
    "type": "object",
    "properties": {
     "dir": {
      "type": "string",
      "default": "portal",
      "description": "지금 보는 도구 dir"
     },
     "title": {
      "type": "string",
      "description": "페이지 제목"
     },
     "name": {
      "type": "string",
      "maxLength": 20,
      "description": "펫 이름"
     },
     "aff": {
      "type": "integer",
      "description": "친밀도"
     },
     "hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
     },
     "occasion": {
      "type": "string",
      "description": "기념일 이름"
     },
     "outfit": {
      "type": "string",
      "description": "입은 옷 이름"
     },
     "speech": {
      "type": "string",
      "description": "옷에 맞는 말투 설명"
     }
    }
   },
   "PadongPetRequest": {
    "type": "object",
    "properties": {
     "event": {
      "type": "string",
      "enum": [
       "chat",
       "idle",
       "greet",
       "wake"
      ],
      "default": "chat"
     },
     "text": {
      "type": "string",
      "maxLength": 300,
      "description": "사용자 말. 없으면 (<event>)"
     },
     "history": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongHistoryItem"
      }
     },
     "context": {
      "$ref": "#/components/schemas/PadongPetContext"
     }
    }
   },
   "PadongOpenTool": {
    "type": "object",
    "required": [
     "dir",
     "name",
     "url"
    ],
    "properties": {
     "dir": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "desc": {
      "type": "string"
     },
     "icon": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "description": "/t/<dir>/"
     }
    }
   },
   "PadongPetResponse": {
    "type": "object",
    "required": [
     "steps",
     "open"
    ],
    "properties": {
     "steps": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongStep"
      }
     },
     "open": {
      "type": "array",
      "maxItems": 3,
      "items": {
       "$ref": "#/components/schemas/PadongOpenTool"
      },
      "description": "event=chat 일 때만 도구 후보(지금 보는 도구 제외), 아니면 []"
     },
     "offline": {
      "type": "boolean",
      "description": "LLM 이 꺼져 낱말 매칭으로 도구를 찾았을 때 true"
     }
    }
   },
   "PadongPushRequest": {
    "type": "object",
    "description": "steps 또는 text 중 하나(둘 다 없으면 400 {\"error\": \"steps 또는 text 필요\"})",
    "properties": {
     "steps": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PadongStep"
      },
      "description": "그대로(정리만 해서) 큐에"
     },
     "text": {
      "type": "string",
      "description": "서버가 LLM 으로 steps 를 만들어 큐에(대화 기록 없이)"
     }
    }
   },
   "PadongPushResponse": {
    "type": "object",
    "required": [
     "id"
    ],
    "properties": {
     "id": {
      "type": "integer"
     }
    }
   },
   "PadongTtsRequest": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 300
     },
     "voice": {
      "type": "string",
      "default": "KR"
     },
     "speed": {
      "type": "number",
      "default": 1.1
     }
    }
   }
  },
  "responses": {
   "BadRequest": {
    "description": "입력이 잘못됨(본문이 JSON 객체가 아님, 필수 값 없음 등)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "Forbidden": {
    "description": "권한 없음(관리자·부서장·만든 사람 전용)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "NotFound": {
    "description": "없는 경로·도구·항목",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "잠금·몰림·가입 제한(code: locked·ip_locked·busy·rate_limited) — Retry-After(초) 뒤 다시",
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer"
      }
     }
    },
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 }
}
