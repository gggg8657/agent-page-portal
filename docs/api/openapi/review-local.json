     }
    }
   }
  },
  "/t/review-local/api/upload": {
   "post": {
    "tags": [
     "review-local"
    ],
    "operationId": "reviewUpload",
    "summary": "원고 업로드 → 추출 + 기계적 점검 + 이력 생성",
    "x-long-running": true,
    "description": "추출 수 초~수십 초. 파일은 JSON 안 base64. 응답은 레코드(review 는 null, issues 는 기계적 점검 결과만). 원본 파일은 추출 뒤 바로 지우고 텍스트·구조만 이력에 남김. 오류: 400 지원하지 않는 형식 / 추출된 글자가 거의 없음(스캔 PDF) / 파일이 비어 있음, 413 {\"error\": \"파일이 너무 큽니다 (최대 60MB)\"}(base64 본문 약 84MB 초과, 포털을 거쳐도 413).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ReviewUploadRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "레코드",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ReviewRecord"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/review-local/api/run": {
   "post": {
    "tags": [
     "review-local"
    ],
    "operationId": "reviewRun",
    "summary": "LLM 리뷰 (SSE)",
    "x-llm": true,
    "x-long-running": true,
    "description": "LLM 심사위원식 리뷰. 빠름 수 분 / 정밀 수십 분. 리뷰는 서버 전체에서 한 번에 하나(wait 단계). 원고 하나 = 이력 하나(다시 돌리면 덮어씀).\n\nSSE: `data: <JSON>\\n\\n`.\n- stage `{\"stage\": \"wait|overview|note|chunk|chunk_done|cross|synth\", \"msg\", \"step\"?, \"steps\"?, \"reset\"?}` — reset 이면 토큰 칸 비우기, 진행률은 step/steps 로 대략\n- token `{\"token\"}` — LLM 출력 원문(진행 표시용)\n- done `{\"done\": ReviewRecord}`\n- error `{\"error\"}`\n\n도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. 작업 id 폴링은 없음 — 도중에 연결을 끊으면 작업이 멈추고 결과가 저장되지 않음(끝까지 연결 유지). 잘못된·없는 id 도 error 이벤트로 옴(400 은 깨진 JSON 만). 끝난 뒤 api/history/<id> 로 다시 읽을 수 있음. 교차 확인(cross)은 API 로 끌 수 없음(항상 켜짐).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ReviewRunRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림(stage·token·done·error)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 줄의 연속 — x-stream-events 참고"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/ReviewStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/ReviewTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/ReviewDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/ReviewErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/review-local/api/history/delete": {
   "post": {
    "tags": [
     "review-local"
    ],
    "operationId": "reviewHistoryDelete",
    "summary": "이력 삭제",
    "description": "없는 id 여도 ok. 형식이 틀리면 400 {\"error\": \"잘못된 이력 id\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "id"
        ],
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "삭제",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
