        }
       },
       "text/plain": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
