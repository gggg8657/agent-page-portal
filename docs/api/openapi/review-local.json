        "docx"
       ]
      }
     }
    ],
    "description": "리뷰 전이면 기계적 점검만 담김. 화면은 location.href 로 이동해 받음.",
    "responses": {
     "200": {
      "description": "보고서 파일",
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename=\"review.<확장자>\"; filename*=UTF-8''<원고이름>_review.<확장자>"
       }
      },
      "content": {
