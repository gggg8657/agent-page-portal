      "type": "string"
     },
     "n": {
      "type": "integer"
     }
    }
   },
   "Post": {
    "type": "object",
    "required": [
     "id",
     "title",
     "body",
     "author",
     "dept",
     "tags",
     "ts",
     "likes",
     "liked"
    ],
    "properties": {
     "id": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "author": {
      "type": "string"
     },
     "dept": {
      "type": "string"
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "ts": {
      "type": "string"
     },
     "likes": {
      "type": "integer"
     },
     "liked": {
      "type": "boolean"
     }
    }
   },
   "ToolsResponse": {
    "type": "object",
    "required": [
     "tools",
