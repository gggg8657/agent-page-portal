     "hidden": {
      "type": "boolean"
     },
     "up": {
      "type": "boolean"
     },
     "installed": {
      "type": "boolean"
     },
     "url": {
      "type": "string"
     },
     "usage": {
      "$ref": "#/components/schemas/Usage"
     }
    }
   },
   "Rank": {
    "type": "object",
    "required": [
