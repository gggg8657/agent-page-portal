 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "Ok": {
    "type": "object",
    "required": [
     "ok"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     }
    }
   },
   "Theme": {
    "type": "string",
    "enum": [
     "classic-light",
     "classic-dark",
     "classic-auto",
     "trendy-light",
     "trendy-dark",
     "trendy-auto",
     "v2-light",
     "v2-dark",
     "v2-auto"
    ]
   },
   "LoginRequest": {
    "type": "object",
    "required": [
     "id",
     "pin"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "pin": {
      "type": "string"
     },
     "remember": {
      "type": "boolean",
      "default": true
     }
    }
   },
   "SignupRequest": {
    "type": "object",
    "required": [
     "id",
     "name",
     "pin"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{1,31}$"
     },
     "name": {
      "type": "string",
      "maxLength": 40
     },
     "pin": {
      "type": "string",
      "pattern": "^[0-9]{4,8}$"
     },
     "dept": {
      "type": "string"
     }
    }
   },
   "LoginOk": {
    "type": "object",
    "required": [
     "ok",
     "id"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     }
    }
   },
   "Me": {
    "type": "object",
    "required": [
     "id",
     "name",
     "owner",
     "role",
     "dept",
     "heads",
     "approvals",
     "account",
     "onboarded"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "owner": {
      "type": "boolean"
     },
     "agent_user": {
      "type": "string"
     },
     "role": {
      "type": "string",
      "description": "관리자·부서장·일반"
     },
     "dept": {
      "type": "string"
     },
     "dept_pending": {
      "type": "string"
     },
     "heads": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "approvals": {
      "type": "integer",
      "description": "내가 처리할 대기 요청 수"
     },
     "account": {
      "type": "boolean",
      "description": "false = 로컬 접속(계정 없음)"
     },
     "onboarded": {
      "type": "boolean"
     }
    }
   },
   "Usage": {
    "type": "object",
    "required": [
     "recent",
     "total",
     "users",
     "likes"
    ],
    "properties": {
     "recent": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "users": {
      "type": "integer"
     },
     "likes": {
      "type": "integer"
     }
    }
   },
   "Tool": {
