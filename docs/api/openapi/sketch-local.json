     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "tikz": {
           "type": "string"
          }
         },
         "required": [
          "tikz"
         ]
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true
   }
  },
  "/t/sketch-local/api/save": {
   "post": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchSave",
    "summary": "작업 묶음 저장(새로/덮어쓰기)",
    "description": "나머지 필드도 그대로 bundle.json 에 저장, 서버가 ts 를 덧붙임. 삭제 API 없음. 사용자별 폴더.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
         "id": {
          "type": [
           "string",
           "null"
          ],
          "description": "YYYY-MM-DD-xxxx 면 덮어씀, 아니면 새 id"
         },
         "image_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "있으면 sketch.png 로 저장(묶음 JSON 에선 빠짐)"
         },
         "source": {
          "type": "string",
          "description": "있으면 diagram.mmd 로도 저장"
         },
         "reading": {
          "$ref": "#/components/schemas/SketchReading"
         },
         "mode": {
          "type": "string"
         },
         "style": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "insight": {
          "type": "string"
         },
         "messages": {
          "type": "array",
          "items": {
           "$ref": "#/components/schemas/SketchMessage"
          }
         },
         "tikz": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string"
          }
         },
         "required": [
          "id"
         ]
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/sketch-local/api/runs": {
   "get": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchRuns",
    "summary": "내 저장 목록(최근 50)",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SketchRun"
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/sketch-local/api/runs/{id}": {
   "get": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchRun",
    "summary": "저장 묶음 하나",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      },
      "description": "형식이 틀리면 화면 HTML 이 옴"
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SketchBundle"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/sketch-local/api/runs/{id}/sketch.png": {
   "get": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchRunImage",
    "summary": "저장된 원본 스케치 이미지",
    "description": "이미지 없이 저장했으면 404.",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      },
      "description": "형식이 틀리면 화면 HTML 이 옴"
     }
    ],
    "responses": {
     "200": {
      "description": "이미지 바이트(실제 형식은 보낸 이미지에 따름). Content-Disposition 없음",
      "content": {
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "probe_blocked",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "SketchReading": {
    "type": "object",
    "properties": {
     "elements": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {
         "type": "string"
        },
        "kind": {
         "type": "string",
         "description": "비전 모델이 준 소문자 문자열(box, actor …) — 고정 목록 없음"
        },
        "uncertain": {
         "type": "boolean"
        }
       },
       "required": [
        "id",
        "label",
        "kind",
        "uncertain"
       ]
      }
     },
     "edges": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "from": {
         "type": "string"
        },
        "to": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "direction": {
         "type": "string",
         "enum": [
          "->",
          "<-",
          "<->",
          "--",
          "?"
         ]
        },
        "uncertain": {
         "type": "boolean"
        }
       },
       "required": [
        "from",
        "to",
        "label",
        "direction",
        "uncertain"
       ]
      }
     },
     "groups": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string"
        },
        "members": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       },
       "required": [
        "label",
        "members"
       ]
      }
     },
     "handwriting_notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "guessed_type": {
      "type": "string"
     },
     "confidence_notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "elements",
     "edges",
     "groups"
    ],
    "additionalProperties": true,
    "description": "api/read 가 만들고 plan·draw·tikz·save 가 받는 구조. 필드가 빠지면 500"
   },
   "SketchModels": {
    "type": "object",
    "properties": {
     "models": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "text": {
      "type": "string",
      "description": "기본 텍스트 모델"
     },
     "vision": {
      "type": "string",
      "description": "기본 비전 모델"
     },
     "vision_models": {
      "type": [
       "array",
       "null"
      ],
      "items": {
       "type": "string"
      },
      "description": "Ollama capabilities 에 vision 이 있는 모델. 조회 실패면 null"
     }
    },
    "required": [
     "models",
     "text",
     "vision",
     "vision_models"
    ]
   },
   "SketchPresets": {
    "type": "object",
    "properties": {
     "styles": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "이름 → 설명(키 순서 = 드롭다운 순서)"
     },
     "types": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    },
    "required": [
     "styles",
     "types"
    ]
   },
   "SketchQuestion": {
    "type": "object",
    "properties": {
     "key": {
      "type": "string",
      "description": "edge:<번호> 또는 elem:<id>"
     },
     "q": {
      "type": "string"
     },
     "options": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "default": {
      "type": "string"
     }
    },
    "required": [
     "key",
     "q"
    ]
   },
   "SketchPlanResult": {
    "type": "object",
    "properties": {
     "reading": {
      "$ref": "#/components/schemas/SketchReading"
     },
     "questions": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/SketchQuestion"
      },
      "maxItems": 3
     },
     "recommend": {
      "type": "object",
      "properties": {
       "type": {
        "type": "string"
       },
       "style": {
        "type": "string"
       },
       "why": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "style",
       "why"
      ]
     }
    },
    "required": [
     "reading",
     "questions",
     "recommend"
    ]
   },
   "SketchMessage": {
    "type": "object",
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "user",
       "assistant"
      ]
     },
     "content": {
      "type": "string"
     }
    },
    "required": [
     "role",
     "content"
    ]
   },
   "SketchTokenEvent": {
    "type": "object",
    "properties": {
     "token": {
      "type": "string"
     }
    },
    "required": [
     "token"
    ]
   },
   "SketchDoneEvent": {
    "type": "object",
    "properties": {
     "done": {
      "type": "object",
      "properties": {
       "source": {
        "type": "string",
        "description": "스타일 frontmatter + 본문 + classDef"
       },
       "insight": {
        "type": "string",
        "description": "인사이트 모드 해설(그 외 빈 문자열)"
       },
       "sanity": {
        "description": "서버 1차 검사 — null 이면 통과. 코드 확인 필요",
        "type": [
         "string",
         "object",
         "null"
        ]
       }
      },
      "required": [
       "source",
       "insight",
       "sanity"
      ]
     }
    },
    "required": [
     "done"
    ]
   },
   "SketchErrorEvent": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ]
   },
   "SketchRun": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "ts": {
      "type": "string"
     },
     "mode": {
      "type": [
       "string",
       "null"
      ]
     },
     "style": {
      "type": [
       "string",
       "null"
      ]
     },
     "type": {
      "type": [
       "string",
       "null"
      ]
     },
     "head": {
      "type": "string",
      "description": "reading 요소 라벨 앞 3개"
     }
    },
    "required": [
     "id",
     "ts",
     "mode",
     "style",
     "type",
     "head"
    ]
   },
   "SketchBundle": {
    "type": "object",
    "additionalProperties": true,
    "description": "저장한 bundle.json 그대로(보낸 필드 + id, ts; image_b64 없음)",
    "properties": {
     "id": {
      "type": "string"
     },
     "ts": {
      "type": "string"
     },
     "reading": {
      "$ref": "#/components/schemas/SketchReading"
     },
     "mode": {
      "type": "string"
     },
     "style": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "insight": {
      "type": "string"
     },
     "messages": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/SketchMessage"
      }
     },
     "tikz": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "ts"
    ]
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "NotFound": {
    "description": "없는 경로·도구·항목",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "ServerError": {
    "description": "서버 내부 오류",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "잠금·몰림·가입 제한(code: locked·ip_locked·busy·rate_limited) — Retry-After(초) 뒤 다시",
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer"
      }
     }
    },
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 }
}
