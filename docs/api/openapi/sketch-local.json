  "/t/sketch-local/api/read": {
   "post": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchRead",
    "summary": "이미지 → 구조(reading)",
    "description": "비전 LLM, 수십 초. 업로드는 JSON 안 base64(데이터 URL 접두어 없이). 서버 크기 제한 코드 없음 — 화면은 긴 변 1600px PNG 로 줄여 보냄. 모델이 JSON 을 안 내거나 image_b64 없으면 500.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "image_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "이미지 base64(data: 접두어 없이)"
         },
         "vision_model": {
          "type": "string",
          "description": "비우면 서버 기본"
         }
        },
        "required": [
         "image_b64"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "reading": {
           "$ref": "#/components/schemas/SketchReading"
          },
          "raw": {
           "type": "string",
           "description": "비전 모델 원문"
          }
         },
         "required": [
          "reading",
          "raw"
         ]
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
  "/t/sketch-local/api/plan": {
   "post": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchPlan",
    "summary": "답변 반영 + 확인 질문 + 스타일/유형 추천",
    "description": "규칙 기반, 즉시. answers 를 보낸 호출에서는 questions 가 항상 [].",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "reading": {
          "$ref": "#/components/schemas/SketchReading"
         },
         "mode": {
          "type": "string",
          "enum": [
           "원본",
           "단순화",
           "인사이트"
          ],
          "default": "원본"
         },
         "answers": {
          "type": [
           "object",
           "null"
          ],
          "additionalProperties": {
           "type": "string"
          },
          "description": "{edge:<번호>: '->'|'<-'|'<->'|'--', elem:<id>: 새 라벨}"
         }
        },
        "required": [
         "reading"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SketchPlanResult"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/sketch-local/api/draw": {
   "post": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchDraw",
    "summary": "reading → Mermaid (SSE), 다듬기 겸용",
    "description": "LLM 스트리밍. 이벤트: {\"token\": \"…\"} LLM 원문 조각 · {\"done\": {\"source\",\"insight\",\"sanity\"}} 끝 · {\"error\": \"…\"} 실패. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. 저장 안 함(api/save).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "reading": {
          "$ref": "#/components/schemas/SketchReading"
         },
         "mode": {
          "type": "string",
          "enum": [
           "원본",
           "단순화",
           "인사이트"
          ],
          "default": "원본"
         },
         "style": {
          "type": "string",
          "description": "스타일 이름(모르면 논문-파스텔)"
         },
         "type": {
          "type": "string",
          "description": "유형 이름(모르면 자동)"
         },
         "max_nodes": {
          "type": "integer",
          "default": 8,
          "description": "단순화 모드 노드 상한"
         },
         "messages": {
          "type": [
           "array",
           "null"
          ],
          "items": {
           "$ref": "#/components/schemas/SketchMessage"
          },
          "description": "다듬기용 이어지는 대화"
         },
         "model": {
          "type": "string"
         }
        },
        "required": [
         "reading"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE. data: {token} … → data: {done:{source,insight,sanity}} 또는 data: {error}. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴(reading 이 빠져도 스트림 안 error).",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 줄의 연속(이벤트 이름 없음)"
        },
        "x-stream-events": [
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/SketchTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/SketchDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/SketchErrorEvent"
          }
         }
        ]
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
  "/t/sketch-local/api/repair": {
   "post": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchRepair",
    "summary": "파싱 오류 소스 LLM 수정 1회",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "source": {
          "type": "string"
         },
         "error": {
          "type": "string",
          "description": "mermaid 파싱 오류"
         },
         "model": {
          "type": "string"
         }
        },
        "required": [
         "source"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "source": {
           "type": "string"
          },
          "sanity": {
           "type": [
            "string",
            "object",
            "null"
           ],
           "description": "null 이면 통과. 코드 확인 필요"
          }
         },
         "required": [
          "source",
          "sanity"
         ]
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true
   }
  },
  "/t/sketch-local/api/tikz": {
   "post": {
    "tags": [
     "sketch-local"
    ],
    "operationId": "sketchTikz",
    "summary": "Mermaid → LaTeX TikZ",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
