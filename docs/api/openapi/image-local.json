 "paths": {
  "/t/image-local/api/status": {
   "get": {
    "tags": [
     "image-local"
    ],
    "operationId": "imageStatus",
    "summary": "GPU 작업 프로세스 상태 + 스타일·비율·품질 목록",
    "description": "비율별 실제 크기(서버 고정): 1:1=1328×1328, 4:3=1472×1104, 3:4=1104×1472, 16:9=1664×928, 9:16=928×1664, 3:2=1584×1056, 2:3=1056×1584",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ImageStatus"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/image-local/api/runs": {
   "get": {
    "tags": [
     "image-local"
    ],
    "operationId": "imageRuns",
    "summary": "내 그림 기록(끝난 것만, 최근 80개 폴더, 최근 수정순)",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ImageRun"
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/image-local/api/runs/{run_id}/{file}": {
   "get": {
    "tags": [
     "image-local"
    ],
    "operationId": "imageFile",
    "summary": "그림 파일(PNG)",
    "description": "파일이 없으면 404 {\"error\":\"없음\"}. 파일 이름 형식이 틀린 경로는 404 가 아니라 화면 HTML(200, text/html) — Content-Type 으로 구분.",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$",
       "description": "YYYY-MM-DD-xxxxxx",
       "example": "2026-10-07-24c0fb"
      }
     },
     {
      "name": "file",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^(img|src)_\\d\\.png$"
      },
      "description": "img_0.png~img_3.png(결과) · src_0.png~src_2.png(고치기 원본)"
     },
     {
      "name": "download",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "있으면(?download=1) 첨부로 받기"
     }
    ],
    "responses": {
     "200": {
      "description": "PNG 바이트. ?download 가 있으면 Content-Disposition 붙음",
      "content": {
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      },
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "download 쿼리가 있을 때만: attachment; filename*=UTF-8''<run_id>_<파일>"
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/image-local/api/generate": {
   "post": {
    "tags": [
     "image-local"
    ],
    "operationId": "imageGenerate",
    "summary": "글 → 그림 (SSE)",
    "description": "SSE(상태 코드 항상 200). 이벤트(data: <JSON>): {stage,msg,run_id?,final_prompt?} 단계 · {step,total,image,run_id} 진행 · {saved,path,run_id} 한 장 저장 · {done:<ImageRun>} 완료 · {error} 오류(스트림 끝, 실패한 묶음 폴더는 지워짐).\n도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. POST 라 EventSource 대신 fetch + body.getReader() 로 읽음.\nGPU 를 씀: 보통 품질 한 장 약 25초, 모델이 안 올라 있으면 30초~1분 더. 동시 요청은 잠금으로 하나씩(대기 순번 알림 없음). 서버 시간 제한 2시간.\n선택적으로 LLM(enhance) 사용. 본문이 JSON 객체가 아니면 스트림 전에 400 {\"error\":\"잘못된 요청\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ImageGenerateRequest"
       }
      }
     }
    },
    "x-gpu": true,
    "x-llm": true,
    "x-long-running": true,
    "responses": {
     "200": {
      "description": "SSE — 이벤트는 description 참고",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 이 이어지는 스트림 (이벤트 이름 줄 없음)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/ImageStageEvent"
          }
         },
         {
          "name": "progress",
          "schema": {
           "$ref": "#/components/schemas/ImageProgressEvent"
          }
         },
         {
          "name": "saved",
          "schema": {
           "$ref": "#/components/schemas/ImageSavedEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/ImageDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/ImageErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/image-local/api/edit": {
   "post": {
    "tags": [
     "image-local"
    ],
    "operationId": "imageEdit",
    "summary": "그림 + 지시 → 고친 그림 (SSE)",
    "description": "SSE(상태 코드 항상 200). 이벤트(data: <JSON>): {stage,msg,run_id?,final_prompt?} 단계 · {step,total,image,run_id} 진행 · {saved,path,run_id} 한 장 저장 · {done:<ImageRun>} 완료 · {error} 오류(스트림 끝, 실패한 묶음 폴더는 지워짐).\n도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. POST 라 EventSource 대신 fetch + body.getReader() 로 읽음.\nGPU 를 씀: 보통 품질 한 장 약 25초, 모델이 안 올라 있으면 30초~1분 더. 동시 요청은 잠금으로 하나씩(대기 순번 알림 없음). 서버 시간 제한 2시간.\n결과는 약 100만 화소. 업로드는 JSON 안 base64(크기 제한은 코드에 없음 — 본문 전체를 한 번에 읽음). 오류 error 이벤트 예: '잘못된 그림 경로'·'없는 그림'·'그림 파일(png·jpg·webp)만'·'고칠 그림을 올리거나 갤러리에서 고르세요'·'어떻게 고칠지 써 주세요'.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ImageEditRequest"
       }
      }
     }
    },
    "x-gpu": true,
    "x-long-running": true,
    "responses": {
     "200": {
      "description": "SSE — generate 와 같은 형식(prompt 단계·final_prompt 없음)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 이 이어지는 스트림 (이벤트 이름 줄 없음)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/ImageStageEvent"
          }
         },
         {
          "name": "progress",
          "schema": {
           "$ref": "#/components/schemas/ImageProgressEvent"
          }
         },
         {
          "name": "saved",
          "schema": {
           "$ref": "#/components/schemas/ImageSavedEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/ImageDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/ImageErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/image-local/api/delete": {
   "post": {
    "tags": [
     "image-local"
    ],
    "operationId": "imageDelete",
    "summary": "그림 묶음 하나를 휴지통(.trash/)으로",
    "description": "폴더를 지우지 않고 .trash/ 로 옮김. 400 {\"error\":\"잘못된 ID\"}(형식) · {\"error\":\"없는 그림\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "run_id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$",
          "description": "YYYY-MM-DD-xxxxxx",
          "example": "2026-10-07-24c0fb"
         }
        },
        "required": [
         "run_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "Ok": {
    "type": "object",
    "required": [
     "ok"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     }
    }
   },
   "ImageStatus": {
    "type": "object",
    "properties": {
     "worker": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "properties": {
         "ok": {
          "type": "boolean"
         },
         "device": {
          "type": "string",
          "description": "어느 GPU 인지 설명(안 올렸으면 '아직 안 올림')"
         },
         "loaded": {
          "type": [
           "string",
           "null"
          ],
          "enum": [
           "generate",
           "edit",
           null
          ]
         },
         "mode": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "ok",
         "device",
         "loaded"
        ]
       }
      ],
      "description": "GPU 작업 프로세스. 꺼져 있으면 null(처음 그릴 때 자동으로 켜짐)"
     },
     "styles": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "키 → 표시 이름(none, photo, illust, 3d, anime, watercolor, poster, logo, product). 요청엔 키"
     },
     "ratios": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "1:1",
        "4:3",
        "3:4",
        "16:9",
        "9:16",
        "3:2",
        "2:3"
       ]
      }
     },
     "quality": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      },
      "description": "fast·normal·high → 표시 이름"
     }
    },
    "required": [
     "worker",
     "styles",
     "ratios",
     "quality"
    ]
   },
   "ImageRun": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$",
      "description": "YYYY-MM-DD-xxxxxx",
      "example": "2026-10-07-24c0fb"
     },
     "kind": {
      "type": "string",
      "enum": [
       "generate",
       "edit"
      ]
     },
     "prompt": {
      "type": "string"
     },
     "final_prompt": {
      "type": "string",
      "description": "그림 모델에 실제로 보낸 문장"
     },
     "negative": {
      "type": "string"
     },
     "style": {
      "type": "string",
      "description": "generate 만"
     },
     "ratio": {
      "type": "string",
      "description": "generate 만"
     },
     "quality": {
      "type": "string"
     },
     "seed": {
      "type": "integer"
     },
     "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^src_\\d\\.png$"
      },
      "description": "edit 만 — 원본 사본 파일 이름"
     },
     "ts": {
      "type": "string"
     },
     "images": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^img_\\d\\.png$"
      }
     }
    },
    "required": [
     "run_id",
     "kind",
     "prompt",
     "ts",
     "images"
    ]
   },
   "ImageGenerateRequest": {
    "type": "object",
    "properties": {
     "prompt": {
      "type": "string",
      "description": "그릴 내용(한국어 가능). 그림 속 글자는 따옴표로"
     },
     "style": {
      "type": "string",
      "default": "none",
      "description": "api/status styles 키. 모르는 값이면 none"
     },
     "ratio": {
      "type": "string",
      "enum": [
       "1:1",
       "4:3",
       "3:4",
       "16:9",
       "9:16",
       "3:2",
       "2:3"
      ],
      "default": "1:1"
     },
     "n": {
      "type": [
       "integer",
       "string"
      ],
      "description": "장수 1~4(범위 밖은 잘림)",
      "default": 1
     },
     "quality": {
      "type": "string",
      "enum": [
       "fast",
       "normal",
       "high"
      ],
      "default": "normal",
      "description": "단계 수 fast 20 / normal 30 / high 50"
     },
     "seed": {
      "type": [
       "integer",
       "string"
      ],
      "description": "정수면 고정, 빈 문자열이면 무작위"
     },
     "negative": {
      "type": "string",
      "description": "빼고 싶은 것(서버가 안전 네거티브를 항상 덧붙임)"
     },
     "enhance": {
      "type": "boolean",
      "default": true,
      "description": "LLM 으로 영어 그림 프롬프트로 다듬기(실패하면 원문 그대로)"
     }
    },
    "required": [
     "prompt"
    ]
   },
   "ImageUpload": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "pattern": "(?i)\\.(png|jpe?g|webp)$",
      "description": ".png·.jpg·.jpeg·.webp 로 끝나야 함"
     },
     "b64": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "data URL 머리 없는 순수 base64"
     }
    },
    "required": [
     "name",
     "b64"
    ]
   },
   "ImageEditRequest": {
    "type": "object",
    "properties": {
     "instruction": {
      "type": "string",
      "description": "어떻게 고칠지(LLM 다듬기 없이 그대로 모델에)"
     },
     "refs": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}/(img|src)_\\d\\.png$"
      },
      "description": "갤러리 그림 '<run_id>/img_0.png'"
     },
     "uploads": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ImageUpload"
      },
      "description": "새 그림. refs 먼저, 그다음 uploads 순서로 합쳐 앞의 3장까지만 씀"
     },
     "n": {
      "type": [
       "integer",
       "string"
      ],
      "description": "장수 1~4(범위 밖은 잘림)",
      "default": 1
     },
     "quality": {
      "type": "string",
      "enum": [
       "fast",
       "normal",
       "high"
      ],
      "default": "normal",
      "description": "단계 수 fast 20 / normal 30 / high 50"
     },
     "seed": {
      "type": [
       "integer",
       "string"
      ],
      "description": "정수면 고정, 빈 문자열이면 무작위"
     },
     "negative": {
      "type": "string"
     }
    },
    "description": "refs·uploads 중 하나 이상 필요",
    "required": [
     "instruction"
    ]
   },
   "ImageStageEvent": {
    "type": "object",
    "properties": {
     "stage": {
      "type": "string",
      "enum": [
       "worker",
       "prompt",
       "draw",
       "load"
      ]
     },
     "msg": {
      "type": "string"
     },
     "run_id": {
      "type": "string",
      "description": "draw 시작 때 확정"
     },
     "final_prompt": {
      "type": "string",
      "description": "draw 시작 때(generate 만)"
     }
    },
    "required": [
     "stage",
     "msg"
    ]
   },
   "ImageProgressEvent": {
    "type": "object",
    "properties": {
     "step": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "image": {
      "type": "integer",
      "description": "0부터 몇 번째 장"
     },
     "run_id": {
      "type": "string"
     }
    },
    "description": "전체 진행률 = (image + step/total) / n",
    "required": [
     "step",
     "total"
    ]
   },
   "ImageSavedEvent": {
    "type": "object",
    "properties": {
     "saved": {
      "type": "integer",
      "description": "장 번호"
     },
     "path": {
      "type": "string",
      "description": "파일 이름만(img_N.png)"
     },
     "run_id": {
      "type": "string"
     }
    },
    "required": [
     "saved",
     "path",
     "run_id"
    ]
   },
   "ImageDoneEvent": {
    "type": "object",
    "properties": {
     "done": {
      "$ref": "#/components/schemas/ImageRun"
     }
    },
    "required": [
     "done"
    ]
   },
   "ImageErrorEvent": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ]
   }
  },
  "responses": {
   "BadRequest": {
    "description": "입력이 잘못됨(본문이 JSON 객체가 아님, 필수 값 없음 등)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "NotFound": {
    "description": "없는 경로·도구·항목",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "잠금·몰림·가입 제한(code: locked·ip_locked·busy·rate_limited) — Retry-After(초) 뒤 다시",
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer"
      }
     }
    },
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  }
 }
}
