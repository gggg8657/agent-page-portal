  },
  "x-tool-id": "image",
  "x-name": "그림 생성",
  "x-description": "말로 그리고 고치는 그림",
  "x-kind": "agent",
  "x-kind-note": "그림은 GPU 확산 모델(worker.py), LLM 은 generate 의 enhance(프롬프트 다듬기)에만",
  "x-category": "기타",
  "x-category-note": "README 분류: 그림",
