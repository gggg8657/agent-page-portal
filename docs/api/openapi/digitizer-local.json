        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/pdfpage/{pdfid}/{page}.png": {
   "get": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerPdfPagePng",
    "summary": "PDF 한 쪽을 PNG 로(썸네일, 저장 안 함)",
    "parameters": [
     {
      "name": "pdfid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{16}$",
       "description": "그림·PDF 내용 SHA-1 앞 16자"
      }
     },
     {
      "name": "page",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "minimum": 1
      }
     },
     {
      "name": "dpi",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 20,
       "maximum": 600,
       "default": 40
      },
      "description": "20~600 으로 자름"
     }
    ],
    "description": "쪽 범위 밖이면 500. 쪽·dpi 따라 수 초. 이 경로만 쿼리(dpi)를 받음.",
    "responses": {
     "200": {
      "description": "PNG",
      "content": {
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/image": {
   "post": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerUpload",
    "summary": "그림 올리기 → 그림 id",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "data": {
          "type": "string",
          "description": "data URL(data:image/png;base64,...) — 쉼표 뒤 base64 만 씀. PIL 이 여는 형식"
         }
        },
        "required": [
         "data"
        ]
       }
      }
     }
    },
    "description": "JSON 안 base64(data URL). 업로드 상한: 원본 40MB(MAX_UPLOAD), POST 본문 약 56MB 초과면 413. 긴 변 6000px 초과 시 줄여 저장. 같은 그림이면 같은 id.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DigitizerImageRef"
        }
       }
      }
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/pdf": {
   "post": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerUploadPdf",
    "summary": "PDF 올리기 → PDF id·쪽 수",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "data": {
          "type": "string",
          "description": "data:application/pdf;base64,... — 내용이 %PDF- 로 시작해야 함"
         }
        },
        "required": [
         "data"
        ]
       }
      }
     }
    },
    "description": "업로드 상한: 원본 40MB(MAX_UPLOAD), POST 본문 약 56MB 초과면 413. PDF 가 아니거나 변환 도구가 없으면 500.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[0-9a-f]{16}$",
           "description": "그림·PDF 내용 SHA-1 앞 16자"
          },
          "pages": {
           "type": "integer"
          }
         },
         "required": [
          "id",
          "pages"
         ]
        }
       }
      }
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/pdfpage": {
   "post": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerPdfPage",
    "summary": "PDF 한 쪽 → 그림 저장 → 그림 id",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "그림·PDF 내용 SHA-1 앞 16자"
         },
         "page": {
          "type": "integer",
          "minimum": 1,
          "default": 1
         },
         "dpi": {
          "type": "integer",
          "minimum": 20,
          "maximum": 600,
          "default": 200
         }
        },
        "required": [
         "id"
        ]
       }
      }
     }
    },
    "description": "수 초.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DigitizerImageRef"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/auto": {
   "post": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerAuto",
    "summary": "자동 보정 + 계열/막대 자동 추출",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "그림·PDF 내용 SHA-1 앞 16자"
         },
         "vlm": {
          "type": "boolean",
          "default": true,
          "description": "false 면 LLM 안 부름"
         },
         "model": {
          "type": "string"
         },
         "xvals": {
          "type": "array",
          "items": {
           "oneOf": [
            {
             "type": "number"
            },
            {
             "type": "string"
            }
           ]
          },
          "description": "눈금 값 직접 지정 — 숫자 또는 '1,000'·'10^3'·'1e-2'·'−0.5'·'10⁻²'. xvals·yvals 둘 다 주면 VLM 건너뜀"
         },
         "yvals": {
          "type": "array",
          "items": {
           "oneOf": [
            {
             "type": "number"
            },
            {
             "type": "string"
            }
           ]
          }
         },
         "chart": {
          "type": "string",
          "enum": [
           "auto",
           "xy",
           "bar",
           "vbar",
           "hbar"
          ],
          "default": "auto"
         },
         "whole": {
          "type": "boolean",
          "description": "true 면 패널 고르기 건너뜀"
         }
        },
        "required": [
         "id"
        ]
       }
      }
