  "/t/digitizer-local/api/export": {
   "post": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerExport",
    "summary": "CSV / XLSX 파일 만들기",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "calib": {
          "$ref": "#/components/schemas/DigitizerCalib"
         },
         "format": {
          "type": "string",
          "enum": [
           "csv",
           "xlsx"
          ],
          "default": "csv"
         },
         "series": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "name": {
             "type": "string"
            },
            "px": {
             "type": "array",
             "items": {
              "type": "array",
              "items": {
               "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y] 픽셀(왼쪽 위 원점, y 아래로 증가)"
             }
            },
            "calib": {
             "$ref": "#/components/schemas/DigitizerCalib"
            }
           },
           "required": [
            "name"
           ]
          },
          "description": "선·점: {name, px, calib?}. 막대: {name} 만"
         },
         "bars": {
          "type": "array",
          "items": {
           "$ref": "#/components/schemas/DigitizerBar"
          },
          "description": "있으면 막대 모드(api/auto 의 bar.bars 모양)"
         },
         "orient": {
          "type": "string",
          "enum": [
           "v",
           "h"
          ],
          "default": "v"
         },
         "meta": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
           "name": {
            "type": "string",
            "description": "파일 이름"
           }
          },
          "description": "그 밖 문자열·숫자는 엑셀 '보정' 시트에"
         },
         "table": {
          "description": "화면이 실어 보내지만 서버는 무시"
         }
        },
        "required": [
         "calib"
        ]
       }
      }
     }
