  "/t/digitizer-local/api/history": {
   "get": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerHistory",
    "summary": "저장된 작업 목록(최근 200)",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "pid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
           },
           "name": {
            "type": "string"
           },
           "saved": {
            "type": "string"
           },
           "image": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "description": "그림·PDF 내용 SHA-1 앞 16자"
           },
           "series": {
            "type": "array",
            "items": {
             "type": "object",
             "properties": {
              "name": {
               "type": "string"
              },
              "n": {
               "type": "integer"
              }
             },
             "required": [
              "name",
              "n"
             ]
            }
           }
          },
          "required": [
           "pid",
           "name",
           "saved"
          ]
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/project/{pid}": {
   "get": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerProject",
    "summary": "저장된 작업 하나 전체",
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
      }
     }
    ],
    "description": "pid 형식이 틀리면 500, 없으면 404.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DigitizerProject"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/digitizer-local/api/img/{id}.png": {
   "get": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerImage",
    "summary": "올린(또는 자른) 그림 PNG",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{16}$",
       "description": "그림·PDF 내용 SHA-1 앞 16자"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "PNG",
      "content": {
