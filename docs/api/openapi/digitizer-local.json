     "200": {
      "description": "파일. CSV 는 UTF-8 BOM·유효숫자 6자리. openpyxl 없으면 xlsx 요청에도 CSV(파일명 확장자로 판단)",
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename*=UTF-8''<meta.name>.csv|xlsx (없으면 digitized)"
       }
      },
      "content": {
       "text/csv": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
