  "/t/digitizer-local/api/meta": {
   "get": {
    "tags": [
     "digitizer-local"
    ],
    "operationId": "digitizerMeta",
    "summary": "기본 모델·모델 목록·PDF/엑셀 지원",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "model": {
           "type": "string"
          },
          "models": {
           "type": "array",
           "items": {
            "type": "string"
           },
           "description": "연결 실패 시 []"
          },
          "pdf": {
           "type": "boolean"
          },
          "xlsx": {
           "type": "boolean",
           "description": "false 면 export 가 xlsx 요청에도 CSV"
          }
         },
         "required": [
          "model",
          "models",
          "pdf",
          "xlsx"
         ]
