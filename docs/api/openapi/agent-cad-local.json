 "paths": {
  "/t/agent-cad-local/api/models": {
   "get": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadModels",
    "summary": "LLM 모델 목록·기본 모델",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CadModels"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/agent-cad-local/api/upload": {
   "post": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadUpload",
    "summary": "DXF/이미지 업로드 → 업로드 id",
    "description": "본문 = 파일 바이트 그대로(multipart·base64 아님). 헤더 X-Filename: encodeURIComponent(파일명)(없으면 upload.dxf). 허용 .dxf .png .jpg .jpeg .webp, 최대 200MB(초과는 400 — 413 아님). DWG 불가. 업로드만으로는 프로젝트에 안 붙음 → api/run 의 upload 로.",
    "parameters": [
     {
      "name": "X-Filename",
      "in": "header",
      "schema": {
       "type": "string"
      },
      "required": false,
      "description": "encodeURIComponent(파일명)"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/octet-stream": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CadUploadResult"
        }
       }
      }
     },
     "400": {
      "description": "확장자 불가('ValueError: DXF 또는 이미지(PNG/JPG)만 …') 또는 '… 200 MB 초과'",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/agent-cad-local/api/run": {
   "post": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadRun",
    "summary": "요청 실행(새 프로젝트 또는 새 리비전) — SSE",
    "description": "LLM·VLM + CAD 빌드: 부품 수십 초, ICT·조립체 수 분. 규칙 위반이면 자동 수리 반복(기본 최대 3회). 빈 prompt·JSON 아님은 스트림 전 400.\n\n이벤트(이름 없음, data: <JSON>\\n\\n): {stage:'route'|'llm'|'vlm'|'build'|'repair', msg, task?} · {log} · {token}(LLM 출력 조각, 대부분 IR JSON) · {project, task}(새 프로젝트일 때만) · 끝 {done:{project, rev, status}} · 실패 {error}. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. Connection: close. EventSource 는 POST 불가 → fetch + getReader(). 연결을 끊어도 서버 작업은 계속되고 리비전은 저장됨. 결과 상세는 done 뒤 GET api/projects/<pid>.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CadRunRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림 (data: <JSON>\\n\\n)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "SSE 스트림 (data: <JSON>\\n\\n)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/CadStageEvent"
          }
         },
         {
          "name": "log",
          "schema": {
           "$ref": "#/components/schemas/CadLogEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/CadTokenEvent"
          }
         },
         {
          "name": "project",
          "schema": {
           "$ref": "#/components/schemas/CadProjectEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/CadDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/CadErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-gpu": true,
    "x-long-running": true
   }
  },
  "/t/agent-cad-local/api/rebuild": {
   "post": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadRebuild",
    "summary": "고친 IR 로 LLM 없이 재빌드(새 리비전) — SSE",
    "description": "새 리비전은 source:'manual'. dxf_edit·dxf_analyze 프로젝트면 error 이벤트 'IR 재빌드는 부품/ICT/조립 작업만'. 필드가 빠져도 스트림을 연 뒤 error 이벤트. 조립은 VLM 시각검증 가능성 — 코드 확인 필요.\n\n이벤트(이름 없음, data: <JSON>\\n\\n): {stage:'route'|'llm'|'vlm'|'build'|'repair', msg, task?} · {log} · {token}(LLM 출력 조각, 대부분 IR JSON) · {project, task}(새 프로젝트일 때만) · 끝 {done:{project, rev, status}} · 실패 {error}. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. Connection: close. EventSource 는 POST 불가 → fetch + getReader(). 연결을 끊어도 서버 작업은 계속되고 리비전은 저장됨. 결과 상세는 done 뒤 GET api/projects/<pid>.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CadRebuildRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림 (data: <JSON>\\n\\n)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "SSE 스트림 (data: <JSON>\\n\\n)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/CadStageEvent"
          }
         },
         {
          "name": "log",
          "schema": {
           "$ref": "#/components/schemas/CadLogEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/CadDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/CadErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-long-running": true
   }
  },
  "/t/agent-cad-local/api/projects": {
   "get": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadProjects",
    "summary": "프로젝트 목록(최대 80, 최신 먼저)",
    "description": "요청한 사용자(X-Agent-User) 폴더 것만. owner 를 주면 그 브라우저 것만, all 이 있으면 owner 필터 무시. 둘 다 없으면 숨기지 않은 전부.",
    "parameters": [
     {
      "name": "owner",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "required": false,
      "description": "브라우저 id"
     },
     {
      "name": "all",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "required": false,
      "description": "값 무관, 있으면 owner 필터 무시"
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/CadProjectSummary"
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/agent-cad-local/api/projects/{pid}": {
   "get": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadProject",
    "summary": "프로젝트 전체(project.json)",
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^\\d{8}-[0-9a-f]{6}$",
       "description": "프로젝트 id YYYYMMDD-xxxxxx"
      },
      "required": true
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CadProject"
        }
       }
      }
     },
     "404": {
      "description": "없음(남의 프로젝트·형식 틀린 id 도 404)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/agent-cad-local/api/projects/{pid}/{rev}/{name}": {
   "get": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadProjectFile",
    "summary": "산출물·원본 파일 받기",
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^\\d{8}-[0-9a-f]{6}$",
       "description": "프로젝트 id YYYYMMDD-xxxxxx"
      },
      "required": true
     },
     {
      "name": "rev",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^(R\\d{2,}|input)$"
      },
      "required": true,
      "description": "리비전(R00…) 또는 input(프로젝트에 붙은 원본)"
     },
     {
      "name": "name",
      "in": "path",
      "schema": {
       "type": "string"
      },
      "required": true,
      "description": "파일명(URL 인코딩). / 포함·. 시작은 404"
     },
     {
      "name": "dl",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "required": false,
      "description": "값 무관 — 있으면 내려받기(Content-Disposition)"
     }
    ],
    "responses": {
     "200": {
      "description": "파일. 보통 report.md·ir.json·미리보기 SVG·STEP/DXF/GLB/CSV. 정확한 목록은 리비전 files",
      "content": {
       "image/svg+xml": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/dxf": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/step": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "model/stl": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "model/gltf-binary": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "text/csv": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "text/markdown": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/json": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/jpeg": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/webp": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/octet-stream": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      },
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "dl 쿼리가 있을 때만: attachment; filename*=UTF-8''<이름>"
       }
      }
     },
     "404": {
      "description": "없음",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/agent-cad-local/api/projects/{pid}/hide": {
   "post": {
    "tags": [
     "agent-cad-local"
    ],
    "operationId": "cadProjectHide",
    "summary": "목록에서 숨김/해제(삭제 아님)",
