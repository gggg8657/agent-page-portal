 "paths": {
  "/t/meeting-local/api/runs": {
   "get": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingRuns",
    "summary": "내 실행 목록(최근 50)",
    "description": "GET 경로는 쿼리를 떼지 않고 비교 — 쿼리를 붙이면 화면 HTML 이 옴.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/MeetingRunSummary"
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/meeting-local/api/runs/{run_id}": {
   "get": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingRun",
    "summary": "실행 하나 전체(전사·화자·회의록·인사이트)",
    "description": "utts 의 speaker 는 지정한 이름으로 바뀌어 나옴.",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MeetingRun"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/meeting-local/api/runs/{run_id}/clip": {
   "get": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingClip",
    "summary": "화자 확인용 짧은 wav(최대 10초)",
    "description": "쿼리는 정확히 s=…&e=… 순서, 숫자(소수점 허용)만 — 순서가 다르면 화면 HTML.",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      }
     },
     {
      "name": "s",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "minimum": 0
      },
      "description": "시작 초"
     },
     {
      "name": "e",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "minimum": 0
      },
      "description": "끝 초"
     }
    ],
    "responses": {
     "200": {
      "description": "wav. Content-Disposition 없음",
      "content": {
       "audio/wav": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/meeting-local/api/runs/{run_id}/{file}": {
   "get": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingRunFile",
    "summary": "결과 파일 다운로드",
    "description": "아직 없으면(1단계만, HWPX 미생성) 404.",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      }
     },
     {
      "name": "file",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "minutes.md",
        "minutes.hwpx",
        "insights.json",
        "transcript.txt",
        "transcript.json"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "결과 파일",
      "content": {
       "application/octet-stream": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      },
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename*=UTF-8''<run_id>_<파일>"
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/meeting-local/api/models": {
   "get": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingModels",
    "summary": "LLM 서버 모델 이름 목록",
    "description": "회의록 모델은 서버 설정 고정(요청으로 못 바꿈). LLM 서버 실패 500.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/meeting-local/api/polish_ok": {
   "get": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingPolishOk",
    "summary": "윤문(kordoc-local) 사용 가능 여부",
    "description": "false 면 윤문 버튼 숨김.",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/meeting-local/api/run": {
   "post": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingRun1",
    "summary": "1단계: 업로드 + 전사 + 화자 분리 (SSE)",
    "description": "GPU ASR, 녹음 길이의 10~30%. 이벤트: {stage,msg} · {done:{…}} · {error}. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. 진행률(%) 없음, ASR 동안 이벤트가 한동안 없을 수 있음. 업로드는 JSON 안 base64, 음성 하나 500MB(MAX_AUDIO_MB) — 넘으면 스트림 전에 413. 본문은 Content-Length 필수(청크 업로드 미지원). 스트림 전 400: JSON 객체 아님, file_b64 없음·base64 아님, speakers 숫자 아님.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "file_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "녹음 파일 base64(data: 접두어 없이), 원본 500MB 이하"
         },
         "file_name": {
          "type": "string",
          "description": "확장자로 형식 판단: .m4a .mp3 .wav .mp4 .webm .ogg .flac .aac .mov"
         },
         "speakers": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "화자 수, 0 = 자동"
         }
        },
        "required": [
         "file_b64"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE. stage(convert→asr→diar) → done(MeetingRun, status=transcribed) 또는 error. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴.",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 줄의 연속(이벤트 이름 없음)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/MeetingStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/MeetingTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/MeetingDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/MeetingErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-gpu": true,
    "x-long-running": true
   }
  },
  "/t/meeting-local/api/finalize/{run_id}": {
   "post": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingFinalize",
    "summary": "2단계: 이름 적용 + 인사이트 + 회의록 (SSE)",
    "description": "LLM, 수 분. 같은 run 에 다시 부르면 덮어씀. hwpx 는 kordoc-local 이 있을 때만. 스트림 전 400(본문·names·meta 가 객체 아님), 전사 결과 없으면 404.",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "names": {
          "type": "object",
          "additionalProperties": {
           "type": "string"
          },
          "description": "{\"화자1\":\"김부장\"} — 빈 값·빠진 화자는 라벨 그대로"
         },
         "meta": {
          "type": "object",
          "properties": {
           "title": {
            "type": "string"
           },
           "date": {
            "type": "string"
           },
           "place": {
            "type": "string"
           }
          },
          "additionalProperties": true,
          "description": "회의 정보(자유 문자열)"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE. stage(segment, insight×구간, minutes reset=true) → token(회의록 Markdown) … → done(MeetingRun, status=done) 또는 error. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴.",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 줄의 연속(이벤트 이름 없음)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/MeetingStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/MeetingTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/MeetingDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/MeetingErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
  "/t/meeting-local/api/polish": {
   "post": {
    "tags": [
     "meeting-local"
    ],
    "operationId": "meetingPolish",
    "summary": "저장된 회의록 윤문(덮어씀)",
    "description": "kordoc-local LLM, 수십 초~. minutes.md 를 덮어쓰고(원문은 minutes_orig.md, 다운로드 API 없음) HWPX 재생성. kordoc 실패 502.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "run_id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
         },
         "strength": {
          "type": "string",
          "enum": [
           "light",
           "standard",
           "strong"
          ],
          "default": "standard"
         }
        },
        "required": [
         "run_id"
        ]
       }
      }
     }
    },
