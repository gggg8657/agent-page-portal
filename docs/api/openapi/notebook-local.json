  "/t/notebook-local/api/nb/{nb_id}/source": {
   "post": {
    "tags": [
     "notebook-local"
    ],
    "operationId": "notebookSource",
    "summary": "출처 추가(SSE) / 포함 토글 / 삭제 (op)",
    "parameters": [
     {
      "name": "nb_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\w+$"
      },
      "description": "노트북 id(16진 8자리). source·chat·note·studio 는 16진이 아니면 500 {\"error\": \"ValueError: 잘못된 id\"}"
     }
    ],
    "x-llm": true,
    "x-long-running": true,
    "description": "op=add(기본): SSE. 파싱(kordoc) → 800자 청크 → 임베딩 → LLM 요약 1콜(앞 6,000자). 큰 문서는 수십 초~수 분. 임베딩 서버가 없으면 BM25 전용으로 저장.\n이벤트: stage `{\"stage\": \"parse|embed|summary\", \"msg\"}` → done `{\"done\": NotebookSourceAdded}` 또는 error `{\"error\": string}`.\nop=toggle·delete: JSON {\"ok\": true}. 파일은 JSON 안 base64(서버 쪽 크기 상한 없음 — 코드상).\n\n도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/NotebookSourceRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "add → SSE, toggle·delete → {\"ok\": true}",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 줄의 연속 — x-stream-events 참고"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/NotebookStageEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/NotebookSourceDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/NotebookErrorEvent"
          }
         }
        ]
       },
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
