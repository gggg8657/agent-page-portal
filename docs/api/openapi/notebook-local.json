    "x-gpu": true,
    "x-long-running": true,
    "description": "포함된 출처 본문을 합쳐 최대 20,000자(출처마다 균등 분할)만 넣음 → truncated. 결과는 자동으로 노트로 저장. 팟캐스트 대본은 A:/B: 줄 형식, 줄마다 TTS 를 불러 이어붙임(수 분).\n이벤트: stage `{\"stage\": \"llm\", \"msg\", \"reset\": true}` → token `{\"token\"}`… → (podcast+TTS) stage `{\"stage\": \"tts\", \"msg\": \"음성 합성 3/40\"}`… → done `{\"done\": NotebookStudioResult}`. TTS 실패는 stage tts 메시지로만 알리고 audio: null. 포함된 출처 없음 → error `{\"error\": \"ValueError: 포함된 출처가 없습니다\"}`.\n\n도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/NotebookStudioRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림(stage·token·done·error)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 줄의 연속 — x-stream-events 참고"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/NotebookStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/NotebookTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/NotebookStudioDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/NotebookErrorEvent"
          }
         }
        ]
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/notebook-local/api/nb/{nb_id}/audio/{file}": {
   "get": {
    "tags": [
     "notebook-local"
    ],
    "operationId": "notebookAudio",
    "summary": "팟캐스트 음성(mp3)",
    "parameters": [
     {
      "name": "nb_id",
      "in": "path",
