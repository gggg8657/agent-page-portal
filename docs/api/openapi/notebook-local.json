      "schema": {
       "type": "string",
       "pattern": "^\\w+$"
      },
      "description": "노트북 id(16진 8자리). source·chat·note·studio 는 16진이 아니면 500 {\"error\": \"ValueError: 잘못된 id\"}"
     },
     {
      "name": "file",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[\\w-]+\\.mp3$"
      },
      "description": "<note_id>.mp3 (studio done.audio)"
     }
    ],
    "description": "<audio src> 로 바로 재생. Content-Disposition 없음. 없으면 404 {\"error\": \"없음\"}.",
    "responses": {
     "200": {
      "description": "mp3",
      "content": {
       "audio/mpeg": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
