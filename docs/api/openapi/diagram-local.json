 ],
 "paths": {
  "/t/diagram-local/api/models": {
   "get": {
    "tags": [
     "diagram-local"
    ],
    "operationId": "diagramModels",
    "summary": "LLM 모델 이름 목록(임베딩 모델도 섞임)",
    "description": "서버 기본 모델은 API 로 안 줌 — model 을 비워 보내면 기본값. 경로는 정확히 일치해야 함(쿼리를 붙이면 화면 HTML 이 옴).",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/diagram-local/api/diagram": {
   "post": {
    "tags": [
     "diagram-local"
    ],
    "operationId": "diagramGenerate",
    "summary": "대화 → Mermaid 소스 생성 (SSE), 결과 저장",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "messages": {
          "type": "array",
          "items": {
           "$ref": "#/components/schemas/DiagramMessage"
          },
          "description": "대화 전체. user·assistant 만 남기고 빈 content 는 버림"
         },
         "type": {
          "allOf": [
           {
            "$ref": "#/components/schemas/DiagramType"
           }
          ],
          "default": "auto"
         },
         "model": {
          "type": "string",
          "description": "비우면 서버 기본"
         }
        },
        "required": [
         "messages"
        ]
       }
      }
     }
    },
    "description": "LLM, 수십 초~수 분. 이벤트 {token} … {done:{id,source,sanity}} 또는 {error}. 도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. 남은 메시지가 없으면 스트림 시작 전 400 {error:'빈 입력'}. 본문이 올바른 JSON 이 아니면 응답 없이 연결이 끊김. done 시점에 기록 저장(사용자별).",
    "x-llm": true,
    "x-long-running": true,
    "responses": {
     "200": {
      "description": "SSE — data: <JSON>\\n\\n, event: 이름 없음",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "SSE — data: <JSON>\\n\\n, event: 이름 없음"
        },
        "x-stream-events": [
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/DiagramTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/DiagramDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/DiagramErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/diagram-local/api/repair": {
   "post": {
    "tags": [
     "diagram-local"
    ],
    "operationId": "diagramRepair",
    "summary": "파싱 오류 난 소스를 LLM 으로 1회 고침",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "source": {
          "type": "string",
          "description": "깨진 Mermaid 소스"
         },
         "error": {
          "type": "string",
          "description": "브라우저 mermaid 파싱 오류 메시지"
         },
         "model": {
          "type": "string"
         }
        },
        "required": [
         "source",
         "error"
        ]
       }
      }
     }
    },
    "description": "스트리밍 아님, 저장 안 함. LLM 실패 → 500.",
    "x-llm": true,
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "source": {
           "type": "string"
          },
          "sanity": {
           "type": [
            "string",
            "null"
           ],
           "description": "서버 1차 검사 — 문제없으면 null, 있으면 '괄호 불일치 []'·'큰따옴표 홀수'·'빈 출력' 등. null 이어도 브라우저 렌더가 실패할 수 있음"
          }
         },
         "required": [
          "source",
          "sanity"
         ]
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/diagram-local/api/runs": {
   "get": {
    "tags": [
     "diagram-local"
    ],
    "operationId": "diagramRuns",
    "summary": "내 최근 기록 50개 요약",
    "description": "최근 수정 순. 폴더가 없으면 [].",
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/DiagramRunSummary"
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/diagram-local/api/runs/{id}": {
   "get": {
    "tags": [
     "diagram-local"
    ],
    "operationId": "diagramRun",
    "summary": "기록 하나 전체",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
      },
      "description": "YYYY-MM-DD-xxxx — 형식이 다르면 화면 HTML 이 옴"
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DiagramRun"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "DiagramType": {
    "type": "string",
    "enum": [
     "auto",
     "flowchart",
     "sequence",
     "class",
     "er",
     "state",
     "gantt",
     "mindmap",
     "timeline",
     "pie"
    ]
   },
   "DiagramMessage": {
    "type": "object",
    "properties": {
     "role": {
      "type": "string",
      "enum": [
       "user",
       "assistant"
      ]
     },
     "content": {
      "type": "string"
     }
    },
    "required": [
     "role",
     "content"
    ]
   },
   "DiagramDoneEvent": {
    "type": "object",
    "properties": {
     "done": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
       },
       "source": {
        "type": "string",
        "description": "코드펜스·<think> 를 걷어낸 최종 Mermaid"
       },
       "sanity": {
        "type": [
         "string",
         "null"
        ],
        "description": "서버 1차 검사 — 문제없으면 null, 있으면 '괄호 불일치 []'·'큰따옴표 홀수'·'빈 출력' 등. null 이어도 브라우저 렌더가 실패할 수 있음"
       }
      },
      "required": [
       "id",
       "source",
       "sanity"
      ]
     }
    },
    "required": [
     "done"
    ]
   },
   "DiagramTokenEvent": {
    "type": "object",
    "properties": {
     "token": {
      "type": "string",
      "description": "LLM 원문 조각(코드펜스·<think> 섞일 수 있음)"
     }
    },
    "required": [
     "token"
    ]
   },
   "DiagramErrorEvent": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ]
   },
   "DiagramRunSummary": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
     },
     "type": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "head": {
      "type": "string",
      "description": "첫 user 메시지 앞 60자"
     },
     "ts": {
      "type": "string",
      "description": "초 단위 ISO, 서버 지역시간"
     }
    },
    "required": [
     "id",
     "type",
     "model",
     "head",
     "ts"
    ]
   },
   "DiagramRun": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
     },
     "type": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "messages": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/DiagramMessage"
      }
     },
     "source": {
      "type": "string"
     },
     "head": {
      "type": "string"
     },
     "ts": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "messages",
     "source"
    ]
   }
  },
  "responses": {
   "BadRequest": {
    "description": "입력이 잘못됨(본문이 JSON 객체가 아님, 필수 값 없음 등)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "NotFound": {
    "description": "없는 경로·도구·항목",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "ServerError": {
    "description": "서버 내부 오류",
    "content": {
