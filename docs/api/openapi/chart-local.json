   },
   "ChartCandidate": {
    "allOf": [
     {
      "$ref": "#/components/schemas/ChartSpec"
     },
     {
      "type": "object",
      "properties": {
       "svg": {
        "type": "string",
        "description": "720×440 SVG 문자열"
       }
      },
      "required": [
       "id",
       "svg"
      ]
     }
    ]
   },
   "ChartRerankResult": {
    "type": "object",
    "description": "AI 순위 결과. ok=false 면 LLM 실패 — order 는 규칙 순서 그대로, reasons·extra 는 비고 note 에 짧은 안내(오류 아님)",
    "properties": {
     "ok": {
      "type": "boolean",
      "description": "LLM 답을 받아 검증까지 했으면 true"
     },
     "order": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "규칙 후보 id 의 새 순서(보낸 후보 각 한 번). 모르는·겹친 id 는 버리고 빠진 id 는 규칙 순서대로 뒤에. AI 제안(extra)은 들어가지 않음 — 화면은 뒤에 붙임"
     },
     "reasons": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
       "type": "string",
       "maxLength": 90
      },
      "description": "후보 id → AI 가 본 이유(한국어, 90자 이하, 표에 없는 숫자가 있으면 버림). 일부 후보만"
     },
     "extra": {
      "type": "array",
      "maxItems": 3,
      "items": {
       "$ref": "#/components/schemas/ChartCandidate"
      },
