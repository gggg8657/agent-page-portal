  "/t/chart-local/api/rerank": {
   "post": {
    "tags": [
     "chart-local"
    ],
    "operationId": "chartRerank",
    "summary": "AI 순위 다시 매기기 + 더 맞는 그래프 제안 (LLM, 선택)",
    "description": "규칙 후보를 보여 준 뒤 따로 부르는 선택 단계. LLM 은 보낸 후보 안에서만 순서를 정하고(앞 12개만 보냄), 지원 종류(meta.kinds) 중 더 맞는 것이 있으면 최대 3개 제안. 서버가 모두 검증: 순서는 아는 id 각 한 번, 이유는 한국어·90자·표에 없는 숫자 금지, 제안은 열·타입·부적합 막기(원그래프 6개 초과·음수 누적·시가·고가·저가·종가 쌓기 등)·실제 SVG/문서 블록 시험·중복 제외. 표 내용은 구분자로 감싼 데이터로만 보냄(지시문 무시). JSON 스키마 안내 디코딩, 형식이 틀리면 한 번 더. LLM 이 꺼졌거나 느리거나 답이 틀리면 200 + ok=false + 규칙 순서. 사용자당 동시 1개(429 code=busy)·10분 10번(429 code=rate_limited, Retry-After). LLM 한 번 90초·다시 묻기 합쳐 120초 제한. id 를 주면 결과를 이력에 저장 — 같은 표로 api/suggest 하면 응답 rerank 로 되살아남.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "table"
        ],
        "properties": {
         "table": {
          "$ref": "#/components/schemas/ChartTable"
         },
         "candidates": {
          "type": "array",
          "maxItems": 60,
          "items": {
           "$ref": "#/components/schemas/ChartSpec"
          },
          "description": "api/suggest 후보에서 svg 를 뺀 것(id c숫자·kind 필수). 없으면 서버가 규칙 후보를 다시 만듦"
         },
         "id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
          "description": "이력 id — 주면 결과(ok 일 때)를 이력 rec.rerank 에 저장"
         },
         "model": {
          "type": "string",
          "description": "모델 이름(기본 meta.model)"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공(LLM 실패도 200 + ok=false)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChartRerankResult"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
  "/t/chart-local/api/export": {
