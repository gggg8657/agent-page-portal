  "/t/chart-local/api/suggest": {
   "post": {
    "tags": [
     "chart-local"
    ],
    "operationId": "chartSuggest",
    "summary": "표 → 그래프 후보(최대 12, 점수순) + SVG, 이력 저장",
    "description": "표 검사: 열·행이 비면 400, 최대 5000행 × 60열. 숫자 열이 없으면 400. id 가 있으면 그 이력 갱신, 없으면 새 이력. 이력에 같은 표·후보의 AI 순위(api/rerank)가 있으면 rerank 로 함께 돌려줌, 표가 바뀌면 지움.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "table": {
          "$ref": "#/components/schemas/ChartTable"
         },
         "id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
          "description": "이력 id YYYYMMDD-HHMMSS-xxxx"
         },
         "source": {
          "type": "string",
          "description": "출처 메모"
         }
        },
        "required": [
         "table"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
           "description": "이력 id YYYYMMDD-HHMMSS-xxxx"
          },
          "candidates": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/ChartCandidate"
           }
          },
          "rerank": {
           "allOf": [
            {
             "$ref": "#/components/schemas/ChartRerankResult"
            }
           ],
           "description": "id 의 이력에 저장된 AI 순위가 지금 표·후보와 같을 때만(stored=true, 제안 svg 는 다시 그림) — 화면은 LLM 을 다시 부르지 않음"
          }
         },
         "required": [
          "id",
          "candidates"
         ]
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
