  "/t/tts-local/audio/{file}": {
   "get": {
    "tags": [
     "tts-local"
    ],
    "operationId": "ttsAudio",
    "summary": "저장된 오디오 받기",
    "parameters": [
     {
      "name": "file",
      "in": "path",
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}\\.(wav|mp3)$"
      },
      "required": true,
      "description": "<run_id>.<wav|mp3> — 확장자는 합성 때 고른 형식과 같아야 함"
     }
    ],
    "responses": {
     "200": {
      "description": "오디오 바이트. Content-Disposition 없음(파일명은 화면이 <run_id>.<format>)",
      "content": {
       "audio/wav": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "audio/mpeg": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "description": "없음 {\"error\":\"없음\"}",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/tts-local/api/tts": {
   "post": {
    "tags": [
     "tts-local"
    ],
    "operationId": "ttsSynthesize",
    "summary": "합성 + 저장, 메타 JSON",
    "description": "스트리밍 없음. 서버 전역 잠금(동시 요청은 줄 섬). 본문 1MB 상한(413). 오류 모양이 OpenAI 형식 {\"error\":{\"message\",\"type\"}} 임에 주의(GET 은 {\"error\":문자열}).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/TtsRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "합성 결과 메타. 오디오는 GET audio/<run_id>.<format>",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TtsRun"
        }
       }
      }
     },
     "400": {
      "description": "빈 입력·speed 범위 밖·형식 오류·발음할 글자 없음 (OpenAI 오류 모양)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OpenAIError"
        }
       }
      }
     },
     "413": {
      "description": "요청이 너무 큼 (본문 최대 1MB) — {\"error\":{\"message\",\"type\":\"invalid_request_error\"}}",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OpenAIError"
        }
       }
      }
     },
     "500": {
      "description": "서버 오류(ffmpeg 없음 등) type=server_error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OpenAIError"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-gpu": true,
    "x-long-running": true
   }
  },
  "/t/tts-local/v1/audio/speech": {
   "post": {
    "tags": [
     "tts-local"
    ],
    "operationId": "ttsSpeech",
    "summary": "OpenAI 호환 합성(바이트 그대로, 저장 안 함)",
    "description": "기록에 저장하지 않음. 오류는 api/tts 와 같음(OpenAI 오류 모양).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/TtsSpeechRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "오디오 바이트",
      "content": {
       "audio/wav": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "audio/mpeg": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "400": {
      "description": "빈 입력·speed 범위 밖·형식 오류·발음할 글자 없음 (OpenAI 오류 모양)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OpenAIError"
        }
       }
      }
     },
     "413": {
      "description": "요청이 너무 큼 (본문 최대 1MB) — {\"error\":{\"message\",\"type\":\"invalid_request_error\"}}",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OpenAIError"
        }
       }
      }
     },
     "500": {
      "description": "서버 오류(ffmpeg 없음 등) type=server_error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/OpenAIError"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-gpu": true,
    "x-long-running": true
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "OpenAIError": {
    "type": "object",
    "required": [
     "error"
    ],
    "description": "OpenAI 호환 오류 모양(tts-local POST 등)",
    "properties": {
     "error": {
      "type": "object",
      "required": [
       "message",
       "type"
      ],
      "properties": {
       "message": {
        "type": "string"
       },
       "type": {
        "type": "string",
        "examples": [
         "invalid_request_error",
         "server_error"
        ]
       }
      }
     }
    }
   },
   "TtsVoices": {
    "type": "object",
    "properties": {
     "voices": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "default": {
      "type": "string"
     },
     "engine": {
      "type": "string"
     },
     "device": {
      "type": "string",
      "description": "cpu / GPU 이름 / 아직 안 올렸으면 '아직 안 올림'"
     }
    },
    "required": [
     "voices",
     "default",
     "engine",
     "device"
    ]
   },
   "TtsModels": {
    "type": "object",
    "properties": {
     "object": {
      "type": "string",
      "enum": [
       "list"
      ]
     },
     "data": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "object": {
         "type": "string",
         "enum": [
          "model"
         ]
        },
        "owned_by": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "object",
        "owned_by"
       ]
      }
     }
    },
    "required": [
     "object",
     "data"
    ]
   },
   "TtsRun": {
    "type": "object",
    "properties": {
     "run_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{4}$"
     },
     "text": {
      "type": "string"
     },
     "voice": {
      "type": "string"
     },
     "speed": {
      "type": "number"
     },
     "format": {
      "type": "string",
      "enum": [
       "wav",
       "mp3"
      ]
     },
     "seconds": {
      "type": "number",
      "description": "오디오 길이(초)"
     },
     "ts": {
      "type": "string",
      "description": "만든 시각 YYYY-MM-DDTHH:MM:SS"
     }
    },
    "required": [
     "run_id",
     "text",
     "voice",
     "speed",
     "format",
     "seconds",
     "ts"
    ]
   },
   "TtsRequest": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "description": "읽을 텍스트(또는 input). 문장 단위로 나눠 합성"
     },
     "input": {
      "type": "string",
      "description": "text 와 같음(OpenAI 이름)"
     },
     "voice": {
      "type": "string",
      "description": "화자 id. 비우면 서버 기본, 모르는 id 면 첫 화자"
     },
     "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2.0,
      "default": 1.0
     },
     "format": {
      "type": "string",
      "enum": [
       "wav",
       "mp3"
      ],
      "default": "wav",
      "description": "또는 response_format. mp3 는 서버 ffmpeg 필요"
     },
     "response_format": {
      "type": "string",
      "enum": [
       "wav",
       "mp3"
      ]
     }
    },
    "description": "text 또는 input 중 하나는 필수"
   },
   "TtsSpeechRequest": {
    "type": "object",
    "properties": {
     "model": {
      "type": "string",
      "description": "무시됨"
     },
     "input": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "voice": {
      "type": "string"
     },
     "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2.0,
      "default": 1.0
     },
     "response_format": {
      "type": "string",
      "enum": [
       "wav",
       "mp3"
      ],
      "default": "wav"
     },
     "format": {
      "type": "string",
      "enum": [
       "wav",
       "mp3"
      ]
     }
    },
    "description": "OpenAI 형식. 필드 규칙은 api/tts 와 같음"
   }
  },
