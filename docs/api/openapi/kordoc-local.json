        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-shared-data": true,
    "description": "등록된 HWPX 양식 — 모든 사용자 공유. can_edit = 이 사용자가 지우거나 종류를 바꿀 수 있는지(만든 계정 또는 owner). 만든 계정 자체는 내보내지 않음. 경로는 정확히 일치해야 함 — 쿼리를 붙이면 화면 HTML 이 돌아옴."
   },
   "post": {
    "tags": [
     "kordoc-local"
    ],
    "operationId": "kordocFormAdd",
    "summary": "양식 등록(분석, LLM 없음). 올린 계정이 주인",
    "requestBody": {
     "required": true,
