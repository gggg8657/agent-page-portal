      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "file_name",
         "file_b64"
        ],
        "properties": {
         "name": {
          "type": "string",
          "maxLength": 60
         },
         "file_name": {
          "type": "string"
         },
         "file_b64": {
          "type": "string",
          "contentEncoding": "base64"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "새 양식",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/KordocForm"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
