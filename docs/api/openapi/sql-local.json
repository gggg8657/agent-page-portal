 "paths": {
  "/t/sql-local/api/models": {
   "get": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlModels",
    "summary": "LLM 모델 이름",
    "responses": {
     "200": {
      "description": "이름",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "description": "LLM 서버 모델 이름 그대로. 서버 기본 모델은 API 로 주지 않음(model 을 비우면 서버 기본). 경로는 정확히 일치해야 함 — GET 에 쿼리를 붙이면 화면 HTML 이 돌아옴."
   }
  },
  "/t/sql-local/api/schema": {
   "get": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlSchema",
    "summary": "테이블·열·FK + 스키마 설명",
    "responses": {
     "200": {
      "description": "스키마",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SqlSchema"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-shared-data": true,
    "description": "연결된 DB 의 테이블·열·FK + 스키마 설명(모든 사용자 공유). db 는 DB 이름만(접속 문자열·비밀번호 없음). locked = 이 사용자가 고칠 수 없는 테이블(owner 는 항상 빈 배열). DB 파일이 없으면 404, 드라이버 없음 등 500. 경로는 정확히 일치해야 함 — GET 에 쿼리를 붙이면 화면 HTML 이 돌아옴."
   }
  },
  "/t/sql-local/api/notes": {
   "post": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlNotes",
    "summary": "스키마 설명 저장(notes 객체 전체)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SqlNotes"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "저장",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "ok"
         ],
         "properties": {
          "ok": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-shared-data": true,
    "x-permission": "creator",
    "description": "스키마 설명 저장. 본문 = notes 객체 전체. 서버는 저장된 것과 테이블 단위로 비교해 바뀐(추가·수정·삭제) 테이블만 권한 검사 후 통째로 저장 — 남의 테이블 설명은 받은 그대로 다시 보내면 됨. 테이블 설명을 처음 쓴 계정이 주인, 주인 또는 owner 만 고치거나 지움(기록 없는 예전 설명은 owner 만) → 아니면 403 {\"error\": \"'논문' 설명은 만든 사람이나 관리자만 고칠 수 있습니다\"}. 서버는 Content-Type 헤더를 보지 않음. 다음 질문부터 LLM 프롬프트에 주석으로 붙음."
   }
  },
  "/t/sql-local/api/ask": {
   "post": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlAsk",
    "summary": "질문 → SQL 생성·실행 (SSE)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/SqlAskRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "SSE 스트림(stage·token·done·error)",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/SqlStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/SqlTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/SqlDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/SqlErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true,
    "description": "자연어 질문 → LLM 이 SQL 생성(1~2회, 수 초~수십 초) → 안전 필터(SELECT/WITH 한 문장만, 금지어, LIMIT 500) → 읽기 전용 실행(최대 10초). 결과는 성공·실패 모두 사용자 기록에 저장.\n\nSSE: `data: <JSON>\\n\\n`(이벤트 이름 없음).\n- stage `{\"stage\": \"llm|run|repair\", \"msg\": string}` — repair 는 실패했을 때만\n- token `{\"token\": string}` — LLM 원문 조각(JSON 텍스트)\n- done `{\"done\": SqlRun}` — SQL 실패·답할 수 없는 질문도 done 으로 오며 run.error 에 사유\n- error `{\"error\": string}` — LLM 연결 실패, LLM 이 JSON 을 안 냄 등 파이프라인 자체 실패\n\n도중 오류도 HTTP 200 으로 오고 스트림 안 error 이벤트(또는 done.error)로만 옴. 빈 질문은 스트림 시작 전 400 {\"error\": \"질문이 비어 있음\"}, 깨진 JSON 400."
   }
  },
  "/t/sql-local/api/rerun": {
   "post": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlRerun",
    "summary": "고친 SQL 직접 실행(LLM 없음, 새 run_id)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "sql"
        ],
        "properties": {
         "sql": {
          "type": "string"
         },
         "chart": {
          "$ref": "#/components/schemas/SqlChart"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "결과",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SqlRun"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "description": "고친 SQL 직접 실행(LLM 없음, 쿼리 최대 10초), 새 run_id 로 저장. 차트 종류·축만 바꿀 때도 이것(쿼리를 다시 실행). 안전 필터 위반·JSON 깨짐 → 400 {\"error\": \"ValueError: SELECT/WITH 로 시작하는 조회만 허용\"} 식, SQL 오류·시간 초과 → 500. 오류 문장의 접속 정보·경로는 *** 로 가려짐. 결과의 model 은 null, question 은 \"(수동 SQL)\"."
   }
  },
  "/t/sql-local/api/runs": {
   "get": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlRuns",
    "summary": "내 최근 기록 50",
    "responses": {
     "200": {
      "description": "목록",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SqlRunSummary"
         }
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "description": "내 최근 기록(파일명 역순 = 대략 최신 먼저, 최대 50). n = 결과 행 수. 삭제 API 는 없음. 경로는 정확히 일치해야 함 — GET 에 쿼리를 붙이면 화면 HTML 이 돌아옴."
   }
  },
  "/t/sql-local/api/runs/{run_id}": {
   "get": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlRun",
    "summary": "기록 하나(표·SVG 포함)",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[\\w-]+$",
       "description": "보통 YYYY-MM-DD-xxxx"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "결과",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SqlRun"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "description": "결과(run) JSON. 없으면 404 {\"error\": \"없음\"}."
   }
  },
  "/t/sql-local/api/runs/{run_id}.csv": {
   "get": {
    "tags": [
     "sql-local"
    ],
    "operationId": "sqlRunCsv",
    "summary": "기록 결과 CSV(UTF-8 BOM, attachment)",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[\\w-]+$",
       "description": "보통 YYYY-MM-DD-xxxx"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "CSV",
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename*=UTF-8''<run_id>.csv"
       }
      },
      "content": {
       "text/csv": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "description": "결과 CSV 내려받기. UTF-8 BOM 포함(엑셀 한글), 첫 줄은 열 이름. 없으면 404."
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
