      "name": "X-Saju-Id",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{8}$"
      },
      "description": "등록 때 받은 id (POST 는 본문 id 가 우선)"
     },
     {
      "name": "X-Saju-Token",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{32}$"
