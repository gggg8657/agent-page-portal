    ]
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "PayloadTooLarge": {
    "description": "요청 본문이 너무 큼 — 상한은 operation description 참고",
    "content": {
