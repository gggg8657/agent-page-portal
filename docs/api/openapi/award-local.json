  "/t/award-local/api/issue": {
   "post": {
    "tags": [
     "award-local"
    ],
    "operationId": "awardIssue",
    "summary": "발급(PDF/PNG/ZIP) + 이력 기록",
    "description": "일괄 번호: cfg.number 마지막 숫자 덩어리를 행마다 +1(자리수 유지), 비면 next_number 부터 자동. 발급마다 PDF 보관 + api/history 기록. 스트리밍 없음. POST 본문 25MB 상한(413). 모든 응답 Cache-Control: no-store. 오류 대부분 500 {\"error\":\"<예외이름>: ...\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AwardIssueRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "파일 바이트",
      "content": {
       "application/pdf": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "image/png": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/zip": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       }
      },
      "headers": {
       "Content-Disposition": {
        "schema": {
         "type": "string"
        },
        "description": "attachment; filename*=UTF-8''<이름> — 한 장 <종류>_<이름>.pdf|png, 여러 장 <종류>_일괄<N>장.pdf|zip (ZIP 안: 001_<번호>_<이름>.pdf|png)"
       }
      }
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-long-running": true
   }
  },
  "/t/award-local/api/upload": {
   "post": {
    "tags": [
     "award-local"
    ],
    "operationId": "awardUpload",
    "summary": "로고·직인 이미지 올리기",
    "description": "이미지 15MB 이하, POST 본문 25MB 이하. 긴 변 2400px 로 줄여 PNG 저장.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "data": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "data:image/...;base64,... 데이터 URL 또는 base64 만"
         }
        },
        "required": [
         "data"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[0-9a-f]{16}$",
           "description": "내용 해시(같은 그림이면 같은 id)"
          }
         },
         "required": [
          "id"
         ]
        }
       }
      }
     },
     "413": {
      "description": "이미지가 너무 큽니다 (15MB 이하) / 요청이 너무 큽니다 (최대 25MB — 이미지 15MB 이하)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "이미지가 아님 'UnidentifiedImageError: ...'",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/award-local/api/rows": {
   "post": {
    "tags": [
     "award-local"
    ],
    "operationId": "awardRows",
    "summary": "명단 붙여넣기/xlsx → 행 목록",
    "description": "탭이 있으면 탭, 없으면 쉼표. 첫 줄이 머리글(이름/성명/name, 소속/부서/dept, 직위/직급/position, 문구/공적/text)이면 그 순서, 아니면 이름,소속,직위,문구. 이름 없는 줄은 버림. xlsx 는 첫 시트만.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "text": {
          "type": "string",
          "description": "붙여넣은 표"
         },
         "xlsx": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "data:...;base64,... (첫 시트)"
         }
        },
        "description": "text 또는 xlsx"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "rows": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/AwardRow"
           }
          }
         },
         "required": [
          "rows"
         ]
        }
       }
      }
     },
     "413": {
      "$ref": "#/components/responses/PayloadTooLarge"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/award-local/api/polish": {
   "post": {
    "tags": [
     "award-local"
    ],
    "operationId": "awardPolish",
    "summary": "수상 문구를 상장 문체로 다듬기",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "text": {
          "type": "string"
         },
         "kind": {
          "type": "string"
         },
         "model": {
          "type": "string",
          "description": "선택"
         }
        },
        "required": [
         "text"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "text": {
           "type": "string",
           "description": "한 단락"
          }
         },
         "required": [
          "text"
         ]
        }
       }
      }
     },
     "400": {
      "description": "다듬을 문구가 비어 있습니다",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "RuntimeError: LLM 서버 연결 실패: ...",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "Ok": {
    "type": "object",
    "required": [
     "ok"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     }
    }
   },
   "AwardDesign": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "enum": [
       "traditional",
       "official",
       "modern",
       "hanji",
       "ribbon",
       "goldframe",
       "goldcorner"
      ]
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ]
   },
   "AwardMeta": {
    "type": "object",
    "properties": {
     "designs": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/AwardDesign"
      }
     },
     "kinds": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "phrases": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
       }
      },
      "description": "종류 → [라벨, 문구] 배열"
     },
     "next_number": {
      "type": "string",
      "description": "이 사용자의 올해 YYYY-NNN 최댓값 + 1"
     },
     "today": {
      "type": "string",
      "format": "date"
     },
     "model": {
      "type": "string",
      "description": "기본 LLM 모델"
     }
    },
    "required": [
     "designs",
     "kinds",
     "phrases",
     "next_number",
     "today"
    ]
   },
   "AwardHistoryItem": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$",
      "description": "발급 한 번(일괄이면 여러 page)"
     },
     "page": {
      "type": "integer"
     },
     "ts": {
      "type": "string"
     },
     "date": {
      "type": "string"
     },
     "number": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "dept": {
      "type": "string"
     },
     "position": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "award": {
      "type": "string"
     },
     "org": {
      "type": "string"
     },
     "design": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "page",
     "ts"
    ],
    "description": "다시 보기: api/issued/<id>.pdf#page=<page>"
   },
   "AwardCfg": {
    "type": "object",
    "properties": {
     "design": {
      "type": "string",
      "description": "api/meta designs[].id — 모르는 값이면 traditional"
     },
     "orient": {
      "type": "string",
      "description": "landscape 면 가로, 그 밖은 세로"
     },
     "kind": {
      "type": "string",
      "description": "큰 제목(상장·표창장·감사장·공로상·우수상 또는 자유 입력)"
     },
     "award": {
      "type": "string",
      "description": "상 이름(선택)"
     },
     "number": {
      "type": "string",
      "description": "'제'로 시작하지 않으면 '제 <번호> 호'. 비면 안 찍힘(일괄 발급은 자동 번호)"
     },
     "name": {
      "type": "string"
     },
     "dept": {
      "type": "string"
     },
     "position": {
      "type": "string"
     },
     "text": {
      "type": "string",
      "description": "본문 문구"
     },
     "date": {
      "type": "string",
