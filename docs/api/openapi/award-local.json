     }
    },
    "description": "상장 설정(preview·issue 공통)"
   },
   "AwardRow": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "dept": {
      "type": "string"
     },
     "position": {
      "type": "string"
     },
     "text": {
      "type": "string",
      "description": "비면 cfg.text"
     }
    },
    "required": [
