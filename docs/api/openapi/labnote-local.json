  "/t/labnote-local/api/notes": {
   "get": {
    "tags": [
     "labnote-local"
    ],
    "operationId": "labnoteNotes",
    "summary": "노트 목록·찾기",
    "description": "사용자별(X-Agent-User → WORKSPACE/u/<id>/notes/). 실험 날짜(없으면 만든 날) 최근 순. q 는 제목·태그·메모·시료 이름(낱말 모두), tag 는 태그 하나(정확히).",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "schema": {
       "type": "string",
       "maxLength": 100
      },
      "description": "찾을 말"
     },
     {
      "name": "from",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "description": "실험 날짜 시작 YYYY-MM-DD"
     },
     {
      "name": "to",
      "in": "query",
      "schema": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "description": "실험 날짜 끝 YYYY-MM-DD"
     },
     {
      "name": "tag",
      "in": "query",
      "schema": {
       "type": "string",
       "maxLength": 100
      },
      "description": "태그(# 없이)"
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LabnoteList"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   },
