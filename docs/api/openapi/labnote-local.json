  "/t/labnote-local/api/notes/{nid}/files": {
   "post": {
    "tags": [
     "labnote-local"
    ],
    "operationId": "labnoteFileAdd",
    "summary": "첨부 올리기(CSV·XLSX 측정 파일·사진)",
    "description": "맨 앞 바이트로 판별 — PNG·JPEG·WebP 는 사진(8MB, 노트당 4장), XLSX(zip)·CSV(utf-8·cp949) 는 측정 파일(10MB, 시트 5개 × 2,000줄). 측정 파일은 올릴 때 표로 읽어 summary(숫자 값 수)를 돌려줌. 같은 이름은 ' (2)'. 노트당 첨부 10개.",
    "parameters": [
     {
      "name": "nid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{10}$"
      },
      "description": "노트 id"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LabnoteUpload"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "만듦",
      "content": {
