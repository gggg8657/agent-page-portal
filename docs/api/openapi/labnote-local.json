  "/t/labnote-local/api/notes/{nid}/build": {
   "post": {
    "tags": [
     "labnote-local"
    ],
    "operationId": "labnoteBuild",
    "summary": "정리 시작(작업)",
    "description": "① 사진(그림 입력을 받는 LLM 이면) 장마다 글로 옮기기 ② 메모·사진 글·측정 파일 머리를 구분자 안 데이터로 LLM 에 — 양식 JSON(스키마 안내 디코딩, 서버 검사·한 번 더) ③ 측정 파일 숫자 칸은 서버가 결과표에 그대로, 날짜 정리(연도 없으면 만든 해 + 알림). 202 로 작업을 돌려주고 …/job 을 2초마다 확인. 양식이 이미 있으면 overwrite: true 가 없을 때 409 confirm. 사용자당 동시 1·1시간 20번, 도구 전체 동시 2.",
    "parameters": [
     {
      "name": "nid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{10}$"
      },
      "description": "노트 id"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/LabnoteBuildRequest"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "시작함",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LabnoteJobWrap"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "description": "이미 정리 중·자리 없음(code: busy) 또는 양식을 덮을지 확인(code: confirm)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "$ref": "#/components/responses/TooManyRequests"
     },
     "503": {
      "description": "LLM 이 연결되지 않음(code: unavailable)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/ServerError"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    },
    "x-llm": true,
    "x-long-running": true
   }
  },
