 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "responses": {
   "BadRequest": {
    "description": "입력이 잘못됨(본문이 JSON 객체가 아님, 필수 값 없음 등)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "로그인 필요 — /login 으로",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Unauthorized"
      }
     }
    }
   },
   "NotFound": {
    "description": "없는 경로·도구·항목",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "ServerError": {
    "description": "서버 내부 오류",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "BadGateway": {
    "description": "도구가 꺼져 있음(응답 없음) → POST /api/start {\"dir\": \"<도구>\"} 로 켠 뒤 다시 시도",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   },
   "TooManyRequests": {
    "description": "잠금·몰림·가입 제한(code: locked·ip_locked·busy·rate_limited) — Retry-After(초) 뒤 다시",
    "headers": {
     "Retry-After": {
      "schema": {
       "type": "integer"
      }
     }
    },
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
      "description": "기계가 구분할 오류 종류(포털이 만든 오류) — 문구 대신 이것으로 분기",
      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "probe_blocked",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "Ok": {
    "type": "object",
    "required": [
     "ok"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     }
    }
   },
   "LabnoteHealth": {
    "type": "object",
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "llm": {
      "type": "boolean"
     }
    },
    "required": [
     "ok",
     "llm"
    ]
   },
   "LabnoteMeta": {
    "type": "object",
    "properties": {
     "llm": {
      "type": "object",
      "properties": {
       "ok": {
        "type": "boolean"
       },
       "model": {
        "type": "string"
       }
      },
      "required": [
       "ok",
       "model"
      ]
     },
     "vision": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "description": "LLM 서버가 그림 입력(image_url)을 받는지 — null 은 아직 확인 중이거나 LLM 꺼짐. false 면 사진은 정리 때 건너뜀"
     },
     "kordoc": {
      "type": "boolean",
      "description": "HWPX 내보내기 가능(kordoc CLI)"
     },
     "notice": {
      "type": "string",
      "description": "숫자 출처·서버 계산 안내 — 화면에 늘 보임"
     },
     "handoff": {
      "type": "object",
      "properties": {
       "to": {
        "type": "string",
        "const": "yield-local"
       }
      },
      "required": [
       "to"
      ]
     },
     "limits": {
      "type": "object",
      "properties": {
       "data_mb": {
        "type": "integer"
       },
       "image_mb": {
        "type": "integer"
       },
       "files": {
        "type": "integer"
       },
       "photos": {
        "type": "integer"
       },
       "notes": {
        "type": "integer"
       },
       "memo_chars": {
        "type": "integer"
       },
       "builds_per_hour": {
        "type": "integer"
       },
       "results_rows": {
        "type": "integer"
       }
      },
      "required": [
       "data_mb",
       "image_mb",
       "files",
       "photos",
       "notes",
       "memo_chars",
       "builds_per_hour",
       "results_rows"
      ]
     },
     "accept": {
      "type": "object",
      "properties": {
       "data": {
        "type": "string"
       },
       "image": {
        "type": "string"
       }
      },
      "required": [
       "data",
       "image"
      ],
      "description": "파일 고르기 accept 값"
     }
    },
    "required": [
     "llm",
     "vision",
     "kordoc",
     "notice",
     "handoff",
     "limits",
