  "/t/yield-local/api/projects/{pid}/analyze": {
   "post": {
    "tags": [
     "yield-local"
    ],
    "operationId": "yieldAnalyze",
    "summary": "분석 시작(작업)",
    "description": "① 시간순 덩어리(12,000자 × 10개)마다 LLM 이 후보 JSON(스키마 안내 디코딩) ② 근거 ref·인용을 서버가 원문에서 확인(비슷함 0.85 이상 + 인용 속 숫자가 원문에 있어야, 확인된 근거가 없으면 후보 탈락·stats.dropped) ③ 같은 후보 합치기(임베딩·제목·같은 근거 + LLM 묶음) ④ 기존 산출물 구절 검색(bge-m3, TOP 4) + LLM 판정(이미 냄·일부·아직 안 냄, 근거 구절 없는 '이미 냄·일부'는 '아직 안 냄'으로 낮추고 note). 202 로 작업을 돌려주고 …/job 을 2초마다 확인. 사용자당 동시 1·1시간 6번, 도구 전체 동시 2.",
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[0-9a-f]{10}$"
      },
      "description": "과제 id"
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/YieldAnalyzeRequest"
       }
      }
     }
    },
    "responses": {
     "202": {
      "description": "시작함",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/YieldJobWrap"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "description": "이미 분석 중이거나 자리가 없음(code: busy)",
