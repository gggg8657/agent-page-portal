  "/t/mail-local/api/history/{id}": {
   "get": {
    "tags": [
     "mail-local"
    ],
    "operationId": "mailHistoryGet",
    "summary": "이력 하나(모든 판 포함)",
    "description": "id 형식이 틀리거나 없으면 404 {\"error\":\"없음\"}",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
       "description": "YYYYMMDD-HHMMSS-xxxx",
       "example": "20261007-062603-e557"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "성공",
      "content": {
       "application/json": {
        "schema": {
