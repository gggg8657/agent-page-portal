      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/mail-local/api/history/delete": {
   "post": {
    "tags": [
     "mail-local"
    ],
    "operationId": "mailHistoryDelete",
    "summary": "이력 삭제",
    "description": "형식이 틀리면 400 {\"error\":\"잘못된 이력 id\"}",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
          "description": "YYYYMMDD-HHMMSS-xxxx",
          "example": "20261007-062603-e557"
         }
        },
        "required": [
         "id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
