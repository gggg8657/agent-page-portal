    "type": "string",
    "enum": [
     "write",
     "reply",
     "polish"
    ],
    "description": "write 작성 · reply 회신 · polish 윤문"
   },
   "MailMeta": {
    "type": "object",
    "properties": {
     "relations": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "purposes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "tones": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "lengths": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "polish_modes": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string",
         "enum": [
          "spell",
          "natural",
          "polite",
          "concise",
          "english"
         ]
        },
        "label": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "label"
       ]
      }
     },
     "model": {
      "type": "string",
      "description": "서버 기본 모델"
     },
     "today": {
      "type": "string",
      "format": "date"
     }
    },
    "required": [
     "relations",
     "purposes",
     "tones",
     "lengths",
     "polish_modes",
     "model",
     "today"
    ]
   },
   "MailHistoryItem": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^\\d{8}-\\d{6}-[0-9a-f]{4}$",
      "description": "YYYYMMDD-HHMMSS-xxxx",
      "example": "20261007-062603-e557"
     },
     "kind": {
      "$ref": "#/components/schemas/MailKind"
     },
