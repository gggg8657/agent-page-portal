      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  },
  "/t/mail-local/api/run": {
   "post": {
    "tags": [
     "mail-local"
    ],
    "operationId": "mailRun",
    "summary": "작성·회신·윤문 실행 (SSE)",
    "description": "LLM 1~2콜, 수 초~수십 초. 결과는 이력에 저장(id 를 주면 같은 이력에 새 판).\n이벤트(data: <JSON>): {\"stage\":\"llm\",\"msg\",\"reset\"?} — reset=true 면 받은 토큰 비우기(윤문 형식 재시도) · {\"token\"} 모델 원문 토큰 · {\"done\":{\"id\",\"kind\",\"version\",\"result\"}} · {\"error\"}.\n도중 오류(예: '핵심 내용을 적어 주세요', 윤문 12,000자 초과)도 HTTP 200 으로 오고 스트림 안 error 이벤트로만 옴. 본문 JSON 이 깨졌을 때만 스트림 전에 400 {\"error\":\"잘못된 요청\"}.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/MailRunRequest"
       }
      }
     }
    },
    "x-llm": true,
    "x-long-running": true,
    "responses": {
     "200": {
      "description": "SSE. 이벤트: {stage:'llm',msg,reset?} → {token}… → {done:{id,kind,version,result}} | {error}",
      "content": {
       "text/event-stream": {
        "schema": {
         "type": "string",
         "description": "data: <JSON>\\n\\n 이 이어지는 스트림 (이벤트 이름 줄 없음)"
        },
        "x-stream-events": [
         {
          "name": "stage",
          "schema": {
           "$ref": "#/components/schemas/MailStageEvent"
          }
         },
         {
          "name": "token",
          "schema": {
           "$ref": "#/components/schemas/MailTokenEvent"
          }
         },
         {
          "name": "done",
          "schema": {
           "$ref": "#/components/schemas/MailDoneEvent"
          }
         },
         {
          "name": "error",
          "schema": {
           "$ref": "#/components/schemas/MailErrorEvent"
          }
         }
        ]
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "502": {
      "$ref": "#/components/responses/BadGateway"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "cookieAuth": {
    "type": "apiKey",
    "in": "cookie",
    "name": "agsid",
    "description": "POST /api/login 이 주는 세션 쿠키(HttpOnly, SameSite=Lax). 같은 출처 fetch 면 브라우저가 자동으로 붙임. 서버 안(127.0.0.1)에서 쿠키 없이 부르면 서버 주인(관리자)으로 처리."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "required": [
     "error"
    ],
    "properties": {
     "error": {
      "type": "string",
      "description": "사람이 읽을 수 있는 한국어 설명"
     },
     "code": {
      "type": "string",
