      "type": "string"
     },
     "org": {
      "type": "string"
     },
     "relation": {
      "type": "string",
      "description": "api/meta relations 중 하나"
     },
     "addr": {
      "type": "string",
      "description": "화면이 보내지만 서버는 쓰지 않음"
     }
    }
   },
   "MailSender": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "dept": {
      "type": "string"
     },
     "sig_ko": {
      "type": "string",
      "description": "있으면 본문 끝에 서명으로 붙임"
     },
     "sig_en": {
      "type": "string"
     }
    },
    "description": "보내는 사람 정보. 화면이 localStorage 에 두고 요청마다 보냄(이력에도 저장됨)"
   },
   "MailInputs": {
    "type": "object",
    "properties": {
     "to": {
      "$ref": "#/components/schemas/MailRecipient"
     },
     "purpose": {
      "type": "string",
      "description": "write: api/meta purposes 중 하나"
     },
     "points": {
      "type": "string",
      "description": "write: 핵심 내용(필수) · reply: 답장 요지"
     },
     "attach": {
      "type": "string"
     },
     "due": {
      "type": "string",
      "description": "write: 날짜 YYYY-MM-DD 권장"
     },
     "tone": {
      "type": "string",
      "description": "api/meta tones"
     },
     "length": {
      "type": "string",
      "description": "api/meta lengths"
     },
     "lang": {
      "type": "string",
      "enum": [
       "ko",
       "en",
       "auto"
      ],
      "description": "write: ko|en · reply: ko|en|auto(원문에 한글이 없으면 영어)"
     },
     "sender": {
      "$ref": "#/components/schemas/MailSender"
     },
     "original": {
      "type": "string",
      "description": "reply: 받은 메일 원문(필수). 12,000자까지만 씀"
     },
     "text": {
      "type": "string",
      "description": "polish: 다듬을 글(필수). 12,000자 넘으면 오류",
      "maxLength": 12000
     },
     "mode": {
      "type": "string",
      "enum": [
       "spell",
       "natural",
       "polite",
       "concise",
       "english"
