      "enum": [
       "bad_request",
       "bad_credentials",
       "locked",
       "ip_locked",
       "busy",
       "rate_limited",
       "unsupported",
       "unavailable",
       "csrf",
       "method_not_allowed",
       "starting",
       "server_error",
       "unauthenticated",
       "forbidden",
       "not_found"
      ]
     }
    }
   },
   "Unauthorized": {
    "type": "object",
    "required": [
     "error",
     "login"
    ],
    "properties": {
     "error": {
      "type": "string",
      "examples": [
       "로그인이 필요합니다"
      ]
     },
     "login": {
      "type": "string",
      "const": "/login"
     }
    }
   },
   "Ok": {
    "type": "object",
    "required": [
     "ok"
    ],
    "properties": {
